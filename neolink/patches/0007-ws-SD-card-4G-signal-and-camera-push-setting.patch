+/// While connected, keeps the 4G signal a mobile camera reports every few seconds; a camera
+/// without 4G never sends it and this just waits
+async fn follow_mobile_network(app: &App, name: &str, camera: &NeoInstance) {
+    let mut last = None;
+    loop {
+        match read(camera, false, |c| {
+            Box::pin(async move { AnyResult::Ok(c.next_net_3g4g_info().await?) })
+        })
+        .await
+        {
+            Ok(info) => {
+                let now = (info.level, info.value, info.mobile_operator);
+                if last != Some(now) {
+                    last = Some(now);
+                    update(app, name, |s| {
+                        s.signal_level = Some(info.level);
+                        s.signal_value = Some(info.value);
+                        s.mobile_operator = info.mobile_operator;
+                    })
+                    .await;
+                }
+            }
+            Err(e) => {
+                log::debug!("{name}: mobile network report failed: {e:#}");
+                sleep(Duration::from_secs(30)).await;
+            }
+        }
+    }
+}
