+/// HddInfoList xml (get 102)
+#[derive(PartialEq, Eq, Default, Debug, Deserialize, Serialize, Clone)]
+pub struct HddInfoList {
+    /// XML Version
+    #[serde(rename = "@version")]
+    pub version: String,
+    /// One entry per storage device
+    #[serde(rename = "HddInfo", default)]
+    pub hdd_info: Vec<HddInfo>,
+}
+
+/// One storage device (SD card)
+#[derive(PartialEq, Eq, Default, Debug, Deserialize, Serialize, Clone)]
+pub struct HddInfo {
+    /// Index of the device
+    pub number: u8,
+    /// Capacity, GB part
+    pub capacity: u32,
+    /// Capacity, MB part (absent on some cameras)
+    #[serde(rename = "capacityM", default, skip_serializing_if = "Option::is_none")]
+    pub capacity_m: Option<u32>,
+    /// 1 when formatted
+    pub format: u8,
+    /// 1 when mounted
+    pub mount: u8,
+    /// Free space, GB part
+    #[serde(rename = "remainSize")]
+    pub remain_size: u32,
+    /// Free space, MB part
+    #[serde(rename = "remainSizeM", default, skip_serializing_if = "Option::is_none")]
+    pub remain_size_m: Option<u32>,
+}
+
+/// Net3g4gInfo xml (pushed by 4G cameras, msg 255)
+#[derive(PartialEq, Eq, Default, Debug, Deserialize, Serialize, Clone)]
+pub struct Net3g4gInfo {
+    /// XML Version
+    #[serde(rename = "@version")]
+    pub version: String,
+    /// Signal level, 0-5 bars
+    #[serde(rename = "sigIntensityLevel")]
+    pub level: u8,
+    /// Signal value as the camera reports it
+    #[serde(rename = "sigIntensityValue")]
+    pub value: i32,
+    /// Network mode
+    #[serde(rename = "netMode", default, skip_serializing_if = "Option::is_none")]
+    pub net_mode: Option<u32>,
+    /// Operator as MCC+MNC (e.g. 26006)
+    #[serde(rename = "mobileOperator", default, skip_serializing_if = "Option::is_none")]
+    pub mobile_operator: Option<u32>,
+}
