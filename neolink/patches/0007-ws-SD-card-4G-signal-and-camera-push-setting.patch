+
+    /// Push notifications from the camera on/off
+    pub async fn get_push_task(&self) -> Result<ScheduleTask> {
+        self.get_xml(MSG_ID_GET_PUSH_TASK)
+            .await?
+            .push_task
+            .ok_or(Error::Other("Expected PushTask xml"))
+    }
+
+    /// Writes the push setting back (send what [Self::get_push_task] returned, changed)
+    pub async fn set_push_task(&self, push_task: ScheduleTask) -> Result<()> {
+        let xml = BcXml {
+            push_task: Some(push_task),
+            ..Default::default()
+        };
+        self.set_xml(MSG_ID_SET_PUSH_TASK, xml).await
+    }
+
+    /// Storage (SD card) state
+    pub async fn get_hdd_info(&self) -> Result<HddInfoList> {
+        self.get_xml(MSG_ID_GET_HDD_INFO)
+            .await?
+            .hdd_info_list
+            .ok_or(Error::Other("Expected HddInfoList xml"))
+    }
+
+    /// Waits for the next mobile network report a 4G camera sends on its own (every few
+    /// seconds while connected)
+    pub async fn next_net_3g4g_info(&self) -> Result<Net3g4gInfo> {
+        let connection = self.get_connection();
+        let mut sub = connection.subscribe_to_id(MSG_ID_NET_3G4G_INFO).await?;
+        loop {
+            let msg = sub.recv().await?;
+            if let BcBody::ModernMsg(ModernMsg {
+                payload:
+                    Some(BcPayloads::BcXml(BcXml {
+                        net_3g4g_info: Some(info),
+                        ..
+                    })),
+                ..
+            }) = msg.body
+            {
+                return Ok(info);
+            }
+        }
+    }
 }
