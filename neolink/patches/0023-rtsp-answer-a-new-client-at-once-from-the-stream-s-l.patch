+//! What a camera's stream looked like the last time: kept to answer a new RTSP client at once
+//!
+//! A battery or 4G camera that sleeps needs 10-20 s to connect and send its first frame, while
+//! RTSP clients give up much sooner: go2rtc (Home Assistant's WebRTC) waits only 5 s for the
+//! answer to DESCRIBE, SETUP and PLAY, whatever `#timeout=` says. The answer to DESCRIBE needs a
+//! prerolled pipeline, and building one needed the camera's codecs and a keyframe.
+//!
+//! So each live view remembers its codecs, frame rate, the first keyframe (with SPS/PPS) and the
+//! first audio frame. The next client gets a pipeline prerolled with those at once, while the
+//! camera connects in the background and its live frames follow when they come. The start is
+//! kept in memory and, when `init` was given a folder, in `<dir>/<camera>-<stream>.start` so it
+//! survives a restart.
+use anyhow::{anyhow, Context, Result};
+use neolink_core::bcmedia::model::{BcMedia, BcMediaAac, BcMediaAdpcm, VideoType};
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::HashMap,
+    path::{Path, PathBuf},
+    sync::{Mutex, OnceLock},
+};
+
+use super::factory::AudioType;
+
+static DIR: OnceLock<PathBuf> = OnceLock::new();
+static MEMORY: Mutex<Option<HashMap<String, StreamStart>>> = Mutex::new(None);
+
+const MAGIC: &[u8; 8] = b"NLSTART1";
+
+/// Keep the starts on disk in `dir` too (created when missing)
+pub(crate) fn init(dir: &Path) {
+    if let Err(e) = std::fs::create_dir_all(dir) {
+        log::warn!(
+            "Stream starts are not kept on disk ({}): {e}",
+            dir.display()
+        );
+        return;
+    }
+    let _ = DIR.set(dir.to_path_buf());
+}
+
+/// The start of one camera stream
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct StreamStart {
+    pub(crate) video: VideoKind,
+    pub(crate) fps: u32,
+    pub(crate) bitrate: u32,
+    /// The first keyframe of the last live view, with its parameter sets
+    pub(crate) keyframe: Vec<u8>,
+    /// The first audio frame of the last live view
+    pub(crate) audio: Option<AudioFrame>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]
+pub(crate) enum VideoKind {
+    H264,
+    H265,
+}
+
+impl From<VideoType> for VideoKind {
+    fn from(video: VideoType) -> Self {
+        match video {
+            VideoType::H264 => VideoKind::H264,
+            VideoType::H265 => VideoKind::H265,
+        }
+    }
+}
+
+impl From<VideoKind> for VideoType {
+    fn from(video: VideoKind) -> Self {
+        match video {
+            VideoKind::H264 => VideoType::H264,
+            VideoKind::H265 => VideoType::H265,
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) enum AudioFrame {
+    Aac(Vec<u8>),
+    Adpcm(Vec<u8>),
+}
+
+impl AudioFrame {
+    pub(crate) fn from_media(media: &BcMedia) -> Option<Self> {
+        match media {
+            BcMedia::Aac(aac) => Some(AudioFrame::Aac(aac.data.clone())),
+            BcMedia::Adpcm(adpcm) => Some(AudioFrame::Adpcm(adpcm.data.clone())),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn audio_type(&self) -> AudioType {
+        match self {
+            AudioFrame::Aac(_) => AudioType::Aac,
+            AudioFrame::Adpcm(data) => AudioType::Adpcm(data.len().saturating_sub(4) as u32),
+        }
+    }
+
+    pub(crate) fn to_media(&self) -> BcMedia {
+        match self {
+            AudioFrame::Aac(data) => BcMedia::Aac(BcMediaAac { data: data.clone() }),
+            AudioFrame::Adpcm(data) => BcMedia::Adpcm(BcMediaAdpcm { data: data.clone() }),
+        }
+    }
+
+    fn data(&self) -> &[u8] {
+        match self {
+            AudioFrame::Aac(data) | AudioFrame::Adpcm(data) => data,
+        }
+    }
+}
+
+/// The audio type a live frame has, to tell whether it fits the pipeline
+pub(crate) fn same_audio(a: &AudioType, b: &AudioType) -> bool {
+    match (a, b) {
+        (AudioType::Aac, AudioType::Aac) => true,
+        (AudioType::Adpcm(x), AudioType::Adpcm(y)) => x == y,
+        _ => false,
+    }
+}
+
+/// The part of the file before the frames
+#[derive(Serialize, Deserialize)]
+struct Header {
+    video: VideoKind,
+    fps: u32,
+    bitrate: u32,
+    keyframe_len: u32,
+    /// "aac" or "adpcm"
+    audio: Option<String>,
+    audio_len: u32,
+}
+
+fn key(camera: &str, stream: &str) -> String {
+    let safe: String = format!("{camera}-{stream}")
+        .chars()
+        .map(|c| {
+            if c.is_ascii_alphanumeric() || c == '-' || c == '_' {
+                c
+            } else {
+                '_'
+            }
+        })
+        .collect();
+    safe
+}
+
+fn path(dir: &Path, camera: &str, stream: &str) -> PathBuf {
+    dir.join(format!("{}.start", key(camera, stream)))
+}
+
+/// The last start of this camera stream: from memory, else from disk
+pub(crate) fn load(camera: &str, stream: &str) -> Option<StreamStart> {
+    let key = key(camera, stream);
+    if let Some(start) = MEMORY
+        .lock()
+        .unwrap()
+        .as_ref()
+        .and_then(|memory| memory.get(&key).cloned())
+    {
+        return Some(start);
+    }
+    let dir = DIR.get()?;
+    match read(&path(dir, camera, stream)) {
+        Ok(start) => {
+            MEMORY
+                .lock()
+                .unwrap()
+                .get_or_insert_with(HashMap::new)
+                .insert(key, start.clone());
+            Some(start)
+        }
+        Err(e) => {
+            log::debug!("{camera}::{stream}: no stream start kept: {e:#}");
+            None
+        }
+    }
+}
+
+/// Remember this start (also on disk when set up)
+pub(crate) fn save(camera: &str, stream: &str, start: StreamStart) {
+    let unchanged = MEMORY
+        .lock()
+        .unwrap()
+        .get_or_insert_with(HashMap::new)
+        .insert(key(camera, stream), start.clone())
+        .is_some_and(|old| old == start);
+    if unchanged {
+        return;
+    }
+    if let Some(dir) = DIR.get() {
+        if let Err(e) = write(&path(dir, camera, stream), &start) {
+            log::warn!("{camera}::{stream}: could not keep the stream start: {e:#}");
+        }
+    }
+}
+
+/// Forget a start that no longer fits the camera
+pub(crate) fn forget(camera: &str, stream: &str) {
+    if let Some(memory) = MEMORY.lock().unwrap().as_mut() {
+        memory.remove(&key(camera, stream));
+    }
+    if let Some(dir) = DIR.get() {
+        let _ = std::fs::remove_file(path(dir, camera, stream));
+    }
+}
+
+fn write(file: &Path, start: &StreamStart) -> Result<()> {
+    let header = Header {
+        video: start.video,
+        fps: start.fps,
+        bitrate: start.bitrate,
+        keyframe_len: start.keyframe.len() as u32,
+        audio: start.audio.as_ref().map(|audio| {
+            match audio {
+                AudioFrame::Aac(_) => "aac",
+                AudioFrame::Adpcm(_) => "adpcm",
+            }
+            .to_string()
+        }),
+        audio_len: start
+            .audio
+            .as_ref()
+            .map(|a| a.data().len() as u32)
+            .unwrap_or(0),
+    };
+    let header = serde_json::to_vec(&header)?;
+    let mut bytes = Vec::with_capacity(MAGIC.len() + 4 + header.len() + start.keyframe.len());
+    bytes.extend_from_slice(MAGIC);
+    bytes.extend_from_slice(&(header.len() as u32).to_le_bytes());
+    bytes.extend_from_slice(&header);
+    bytes.extend_from_slice(&start.keyframe);
+    if let Some(audio) = start.audio.as_ref() {
+        bytes.extend_from_slice(audio.data());
+    }
+    // Whole file or nothing: a start cut short would preroll a broken keyframe
+    let partial = file.with_extension("start.part");
+    std::fs::write(&partial, &bytes).with_context(|| format!("writing {}", partial.display()))?;
+    std::fs::rename(&partial, file)?;
+    Ok(())
+}
+
+fn read(file: &Path) -> Result<StreamStart> {
+    let bytes = std::fs::read(file)?;
+    let rest = bytes
+        .strip_prefix(MAGIC.as_slice())
+        .ok_or_else(|| anyhow!("not a stream start file"))?;
+    let (len, rest) = rest
+        .split_at_checked(4)
+        .ok_or_else(|| anyhow!("cut short"))?;
+    let len = u32::from_le_bytes([len[0], len[1], len[2], len[3]]) as usize;
+    let (header, rest) = rest
+        .split_at_checked(len)
+        .ok_or_else(|| anyhow!("cut short"))?;
+    let header: Header = serde_json::from_slice(header)?;
+    let (keyframe, rest) = rest
+        .split_at_checked(header.keyframe_len as usize)
+        .ok_or_else(|| anyhow!("cut short"))?;
+    let (audio, rest) = rest
+        .split_at_checked(header.audio_len as usize)
+        .ok_or_else(|| anyhow!("cut short"))?;
+    if !rest.is_empty() || keyframe.is_empty() {
+        return Err(anyhow!("unexpected length"));
+    }
+    let audio = match header.audio.as_deref() {
+        Some("aac") => Some(AudioFrame::Aac(audio.to_vec())),
+        Some("adpcm") => Some(AudioFrame::Adpcm(audio.to_vec())),
+        Some(other) => return Err(anyhow!("unknown audio {other}")),
+        None => None,
+    };
+    Ok(StreamStart {
+        video: header.video,
+        fps: header.fps,
+        bitrate: header.bitrate,
+        keyframe: keyframe.to_vec(),
+        audio,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn sample() -> StreamStart {
+        StreamStart {
+            video: VideoKind::H264,
+            fps: 15,
+            bitrate: 262144,
+            keyframe: vec![0, 0, 0, 1, 0x67, 1, 2, 3],
+            audio: Some(AudioFrame::Aac(vec![0xff, 0xf1, 9, 9])),
+        }
+    }
+
+    fn temp_dir(name: &str) -> PathBuf {
+        let dir = std::env::temp_dir().join(format!("neolink-start-{}-{name}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        dir
+    }
+
+    #[test]
+    fn a_stream_start_survives_the_disk() {
+        let dir = temp_dir("disk");
+        let file = path(&dir, "G330", "subStream");
+        write(&file, &sample()).unwrap();
+        assert_eq!(read(&file).unwrap(), sample());
+
+        let silent = StreamStart {
+            audio: None,
+            ..sample()
+        };
+        write(&file, &silent).unwrap();
+        assert_eq!(read(&file).unwrap(), silent);
+    }
+
+    #[test]
+    fn a_damaged_start_file_is_not_used() {
+        let dir = temp_dir("damaged");
+        let file = path(&dir, "G330", "subStream");
+        write(&file, &sample()).unwrap();
+        let bytes = std::fs::read(&file).unwrap();
+        std::fs::write(&file, &bytes[..bytes.len() - 2]).unwrap();
+        assert!(read(&file).is_err());
+        std::fs::write(&file, b"something else").unwrap();
+        assert!(read(&file).is_err());
+    }
+
+    #[test]
+    fn a_camera_name_stays_one_file_name() {
+        assert_eq!(key("../a b/c", "mainStream"), "___a_b_c-mainStream");
+    }
+
+    #[test]
+    fn the_last_start_is_remembered_and_can_be_forgotten() {
+        save("memory-test", "subStream", sample());
+        assert_eq!(load("memory-test", "subStream"), Some(sample()));
+        forget("memory-test", "subStream");
+        assert_eq!(load("memory-test", "subStream"), None);
+    }
+
+    #[test]
+    fn audio_frames_keep_their_kind() {
+        let adpcm = AudioFrame::Adpcm(vec![0; 4 + 512]);
+        assert!(same_audio(&adpcm.audio_type(), &AudioType::Adpcm(512)));
+        assert!(!same_audio(&adpcm.audio_type(), &AudioType::Aac));
+        assert_eq!(AudioFrame::from_media(&adpcm.to_media()), Some(adpcm));
+    }
+}
