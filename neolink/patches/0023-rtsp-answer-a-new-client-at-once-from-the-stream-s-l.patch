+/// A client of a camera whose stream start is known: its pipeline is built and prerolled from
+/// that start at once, so the RTSP answers come before a client gives up, and the camera is
+/// woken in the background. Its live frames follow from its first keyframe on.
+async fn quick_start(
+    camera: NeoInstance,
+    name: String,
+    stream: StreamKind,
+    config: crate::config::CameraConfig,
+    element: Element,
+    reply: tokio::sync::oneshot::Sender<Element>,
+    kept: StreamStart,
+) -> AnyResult<()> {
+    let stream_config = StreamConfig::from_start(&kept);
+    let (vid_src, aud_src) =
+        build_sources(&element, &stream_config, &config.splash_pattern.to_string())?;
+    let _ = reply.send(element);
+    log::info!("{name}::{stream}: answered from the last stream start, waking the camera");
+
+    let mut view = LiveView::new(
+        name,
+        stream,
+        vid_src,
+        aud_src,
+        stream_config,
+        config.pause.on_motion,
+        Some(kept),
+    );
+    let runtime = tokio::runtime::Handle::current();
+    std::thread::spawn(move || {
+        // Preroll first: the RTSP answer waits for it, the camera does not have to
+        view.preroll_kept()?;
+        let media_rx = runtime.block_on(camera.stream_while_live(stream))?;
+        view.run(&runtime, media_rx, vec![])
+    });
+    Ok(())
+}
+
+/// Build the video and audio branches of a client's pipeline for this stream
+fn build_sources(
+    element: &Element,
+    stream_config: &StreamConfig,
+    splash_pattern: &str,
+) -> AnyResult<(Option<AppSrc>, Option<AppSrc>)> {
+    let vid_src = match stream_config.vid_type.as_ref() {
+        Some(VideoType::H264) => Some(build_h264(element, stream_config)?),
+        Some(VideoType::H265) => Some(build_h265(element, stream_config)?),
+        None => {
+            build_unknown(element, splash_pattern)?;
+            None
+        }
+    };
+    let aud_src = match stream_config.aud_type.as_ref() {
+        Some(AudioType::Aac) => Some(build_aac(element, stream_config)?),
+        Some(AudioType::Adpcm(block_size)) => {
+            Some(build_adpcm(element, *block_size, stream_config)?)
+        }
+        None => None,
+    };
+    for app in vid_src.iter().chain(aud_src.iter()) {
+        app.set_callbacks(
+            AppSrcCallbacks::builder()
+                .seek_data(move |_, _seek_pos| true)
+                .build(),
+        );
+    }
+    Ok((vid_src, aud_src))
+}
+
+/// How long a client started from a kept stream start waits for the camera's first frame: the
+/// time a sleeping 4G camera may need to wake, connect over the relay and start its stream
+const FIRST_MEDIA_LIMIT: Duration = Duration::from_secs(60);
+
+/// How long the kept start may wait for the pipeline to take it (the RTSP server sets the
+/// pipeline to PAUSED right after the factory has answered)
+const PREROLL_LIMIT: Duration = Duration::from_secs(5);
+
+/// Copies of the kept keyframe and sound pushed for the preroll
+const PREROLL_KEYFRAMES: usize = 2;
+const PREROLL_AUDIO_FRAMES: usize = 4;
+
+fn us(micros: u32) -> Duration {
+    Duration::from_micros(micros as u64)
+}
+
+/// One client's live view: sends the camera's frames into its pipeline, on a thread of its own
+struct LiveView {
+    name: String,
+    stream: StreamKind,
+    vid_src: Option<AppSrc>,
+    aud_src: Option<AppSrc>,
+    stream_config: StreamConfig,
+    recorder: Option<Recorder>,
+    idle_limit: Option<Duration>,
+    kept: Option<StreamStart>,
+    /// The timestamps after the kept start that was pushed for the preroll
+    start_ts: (u32, u32),
+    learner: StartLearner,
+}
+
+impl LiveView {
+    fn new(
+        name: String,
+        stream: StreamKind,
+        vid_src: Option<AppSrc>,
+        aud_src: Option<AppSrc>,
+        stream_config: StreamConfig,
+        paused_on_motion: bool,
+        kept: Option<StreamStart>,
+    ) -> Self {
+        // The live view is also written to a file when its camera records
+        let recorder = stream_config.vid_type.and_then(|video| {
+            Recorder::start(
+                &name,
+                video,
+                matches!(stream_config.aud_type, Some(AudioType::Aac)),
+            )
+        });
+        Self {
+            learner: StartLearner::new(&name, stream),
+            name,
+            stream,
+            vid_src,
+            aud_src,
+            stream_config,
+            recorder,
+            // Paused on motion, a camera is silent on purpose
+            idle_limit: (!paused_on_motion).then_some(MEDIA_IDLE_LIMIT),
+            kept,
+            start_ts: (0, 0),
+        }
+    }
+
+    fn run(
+        mut self,
+        runtime: &tokio::runtime::Handle,
+        mut media_rx: tokio::sync::mpsc::Receiver<BcMedia>,
+        buffer: Vec<BcMedia>,
+    ) -> AnyResult<()> {
+        let name = self.name.clone();
+        let stream = self.stream;
+        let (mut vid_ts, mut aud_ts) = self.start_ts;
+        let mut pools = SendState::default();
+        // A client started from a kept start shows no live video before a live keyframe
+        let mut need_keyframe = false;
+
+        if let Some(kept) = self.kept.take() {
+            need_keyframe = true;
+            // Wait for the waking camera, as long as the client is still there
+            let Some(first) = self.first_media(runtime, &mut media_rx) else {
+                self.end();
+                return Ok(());
+            };
+            if !self.fits(&first, &kept) {
+                log::info!("{name}::{stream}: the camera's stream changed, starting over");
+                start_cache::forget(&name, &stream.to_string());
+                self.end();
+                return Ok(());
+            }
+            self.send(
+                first,
+                &mut pools,
+                &mut vid_ts,
+                &mut aud_ts,
+                &mut need_keyframe,
+            )?;
+        }
+
+        log::trace!("{name}::{stream}: Sending buffered frames");
+        for buffered in buffer {
+            self.send(
+                buffered,
+                &mut pools,
+                &mut vid_ts,
+                &mut aud_ts,
+                &mut need_keyframe,
+            )?;
+        }
+
+        log::trace!("{name}::{stream}: Sending new frames");
+        while let Some(data) = next_media(runtime, &mut media_rx, self.idle_limit) {
+            let r = self.send(
+                data,
+                &mut pools,
+                &mut vid_ts,
+                &mut aud_ts,
+                &mut need_keyframe,
+            );
+            if let Err(r) = &r {
+                log::info!("Failed to send to source: {r:?}");
+            }
+            r?;
+        }
+        // Silent camera: end the client's stream too, the camera's session was let go with the
+        // receiver
+        self.end();
+        log::info!("{name}::{stream}: live view ended");
+        AnyResult::Ok(())
+    }
+
+    /// One frame of the camera into the pipeline (and the recorder)
+    fn send(
+        &mut self,
+        data: BcMedia,
+        pools: &mut SendState,
+        vid_ts: &mut u32,
+        aud_ts: &mut u32,
+        need_keyframe: &mut bool,
+    ) -> AnyResult<()> {
+        self.learner.see(&data, &self.stream_config);
+        if let BcMedia::InfoV1(_) | BcMedia::InfoV2(_) = &data {
+            self.stream_config.update_from_media(&data);
+        }
+        match &data {
+            BcMedia::Pframe(_) if *need_keyframe => return Ok(()),
+            BcMedia::Iframe(_) => *need_keyframe = false,
+            BcMedia::Aac(_) | BcMedia::Adpcm(_) => {
+                // Sound of another kind than the pipeline was built for cannot go in
+                let fits = match (&self.stream_config.aud_type, AudioFrame::from_media(&data)) {
+                    (Some(built), Some(frame)) => {
+                        start_cache::same_audio(built, &frame.audio_type())
+                    }
+                    _ => true,
+                };
+                if !fits {
+                    return Ok(());
+                }
+            }
+            _ => {}
+        }
+        send_to_sources(
+            data,
+            pools,
+            &self.vid_src,
+            &self.aud_src,
+            vid_ts,
+            aud_ts,
+            &self.stream_config,
+            self.recorder.as_ref(),
+        )
+    }
+
+    /// Push the kept keyframe and sound, so that the pipeline prerolls without the camera
+    fn preroll_kept(&mut self) -> AnyResult<()> {
+        let Some(kept) = self.kept.clone() else {
+            return Ok(());
+        };
+        log::trace!(
+            "{}::{}: Prerolling with the kept stream start",
+            self.name,
+            self.stream
+        );
+        let (mut vid_ts, mut aud_ts) = (0, 0);
+        self.preroll(&kept, &mut vid_ts, &mut aud_ts)?;
+        self.start_ts = (vid_ts, aud_ts);
+        Ok(())
+    }
+
+    fn preroll(&self, kept: &StreamStart, vid_ts: &mut u32, aud_ts: &mut u32) -> AnyResult<()> {
+        if let Some(vid_src) = self.vid_src.as_ref() {
+            // A byte-stream parser lets a frame go only when the next one begins: the keyframe
+            // twice, so that the first one reaches the payloader
+            let frame = 1_000_000 / self.stream_config.fps.max(1);
+            for _ in 0..PREROLL_KEYFRAMES {
+                push_when_taken(vid_src, kept.keyframe.clone(), us(*vid_ts))?;
+                *vid_ts += frame;
+            }
+        }
+        if let (Some(aud_src), Some(audio)) = (self.aud_src.as_ref(), kept.audio.as_ref()) {
+            let media = audio.to_media();
+            let duration = match &media {
+                BcMedia::Aac(aac) => aac.duration(),
+                BcMedia::Adpcm(adpcm) => adpcm.duration(),
+                _ => None,
+            }
+            .unwrap_or(64_000);
+            let data = match media {
+                BcMedia::Aac(aac) => aac.data,
+                BcMedia::Adpcm(adpcm) => adpcm.data,
+                _ => unreachable!("audio frame"),
+            };
+            // The parser checks the next frame's header, the encoders need whole frames of
+            // their own: a short repeat of the kept sound
+            for _ in 0..PREROLL_AUDIO_FRAMES {
+                push_when_taken(aud_src, data.clone(), us(*aud_ts))?;
+                *aud_ts += duration;
+            }
+        }
+        Ok(())
+    }
+
+    /// The camera's first frame, waiting up to FIRST_MEDIA_LIMIT while the client is there
+    fn first_media(
+        &self,
+        runtime: &tokio::runtime::Handle,
+        media_rx: &mut tokio::sync::mpsc::Receiver<BcMedia>,
+    ) -> Option<BcMedia> {
+        let started = Instant::now();
+        while started.elapsed() < FIRST_MEDIA_LIMIT {
+            let step = runtime.block_on(async {
+                tokio::time::timeout(Duration::from_secs(1), media_rx.recv()).await
+            });
+            match step {
+                Ok(media) => return media,
+                Err(_) => {
+                    let gone = self
+                        .vid_src
+                        .iter()
+                        .chain(self.aud_src.iter())
+                        .any(|src| check_live(src).is_err());
+                    if gone {
+                        log::info!(
+                            "{}::{}: the client left before the camera woke",
+                            self.name,
+                            self.stream
+                        );
+                        return None;
+                    }
+                }
+            }
+        }
+        log::info!(
+            "{}::{}: the camera sent nothing for {FIRST_MEDIA_LIMIT:?}, ending the live view",
+            self.name,
+            self.stream
+        );
+        None
+    }
+
+    /// Whether the camera's live frame fits the pipeline built from the kept start
+    fn fits(&self, media: &BcMedia, kept: &StreamStart) -> bool {
+        match media {
+            BcMedia::Iframe(BcMediaIframe { video_type, .. })
+            | BcMedia::Pframe(BcMediaPframe { video_type, .. }) => {
+                VideoKind::from(*video_type) == kept.video
+            }
+            _ => true,
+        }
+    }
+
+    fn end(&self) {
+        for src in self.vid_src.iter().chain(self.aud_src.iter()) {
+            let _ = src.end_of_stream();
+        }
+    }
+}
+
+/// Learns the start of a live view (its first keyframe and sound) to keep it for the next client
+struct StartLearner {
+    camera: String,
+    stream: String,
+    keyframe: Option<(VideoKind, Vec<u8>)>,
+    audio: Option<AudioFrame>,
+    frames_after_keyframe: usize,
+    done: bool,
+}
+
+/// Frames after the keyframe within which the sound is waited for before keeping a start without
+const AUDIO_WAIT_FRAMES: usize = 30;
+
+impl StartLearner {
+    fn new(camera: &str, stream: StreamKind) -> Self {
+        Self {
+            camera: camera.to_string(),
+            stream: stream.to_string(),
+            keyframe: None,
+            audio: None,
+            frames_after_keyframe: 0,
+            done: false,
+        }
+    }
+
+    fn see(&mut self, media: &BcMedia, stream_config: &StreamConfig) {
+        if self.done {
+            return;
+        }
+        match media {
+            BcMedia::Iframe(BcMediaIframe {
+                video_type, data, ..
+            }) if self.keyframe.is_none() => {
+                self.keyframe = Some(((*video_type).into(), data.clone()));
+            }
+            BcMedia::Aac(_) | BcMedia::Adpcm(_) if self.audio.is_none() => {
+                self.audio = AudioFrame::from_media(media);
+            }
+            _ => {}
+        }
+        if self.keyframe.is_some() {
+            self.frames_after_keyframe += 1;
+        }
+        let Some((video, keyframe)) = self.keyframe.as_ref() else {
+            return;
+        };
+        if self.audio.is_none() && self.frames_after_keyframe < AUDIO_WAIT_FRAMES {
+            return;
+        }
+        start_cache::save(
+            &self.camera,
+            &self.stream,
+            StreamStart {
+                video: *video,
+                fps: stream_config.fps,
+                bitrate: stream_config.bitrate,
+                keyframe: keyframe.clone(),
+                audio: self.audio.clone(),
+            },
+        );
+        self.done = true;
+    }
+}
+
+/// Push a buffer once the pipeline takes it (it is not PAUSED yet right after the factory answered)
+fn push_when_taken(appsrc: &AppSrc, data: Vec<u8>, ts: Duration) -> AnyResult<()> {
+    let started = Instant::now();
+    let time = ClockTime::from_useconds(ts.as_micros() as u64);
+    loop {
+        let mut buf = gstreamer::Buffer::from_mut_slice(data.clone());
+        {
+            let buf_mut = buf.get_mut().expect("A new buffer is writable");
+            buf_mut.set_dts(time);
+            buf_mut.set_pts(time);
+        }
+        match appsrc.push_buffer(buf) {
+            Ok(_) => return Ok(()),
+            Err(FlowError::Flushing) if started.elapsed() < PREROLL_LIMIT => {
+                check_live(appsrc)?;
+                std::thread::sleep(Duration::from_millis(10));
+            }
+            Err(e) => return Err(anyhow!("Could not preroll {}: {e:?}", appsrc.name())),
+        }
+    }
+}
