+#[test]
+fn test_sd_day_records_reply() {
+    let sample = indoc!(
+        r#"
+        <?xml version="1.0" encoding="UTF-8" ?>
+        <body>
+        <DayRecords version="1.1">
+        <startTime><year>2026</year><month>9</month><day>1</day><hour>0</hour><minute>0</minute><second>0</second></startTime>
+        <endTime><year>2026</year><month>9</month><day>30</day><hour>23</hour><minute>59</minute><second>59</second></endTime>
+        <DayRecordList>
+        <DayRecord>
+        <index>0</index>
+        <channelId>0</channelId>
+        <dayTypeList>
+        <dayType><index>1</index><type>normal</type></dayType>
+        <dayType><index>19</index><type>normal</type></dayType>
+        </dayTypeList>
+        </DayRecord>
+        </DayRecordList>
+        </DayRecords>
+        </body>
+    "#
+    );
+    let b = BcXml::try_parse(sample.as_bytes()).unwrap();
+    let records = b.day_records.unwrap().list.unwrap().records;
+    let days: Vec<u8> = records[0]
+        .day_types
+        .as_ref()
+        .unwrap()
+        .days
+        .iter()
+        .map(|d| d.index)
+        .collect();
+    assert_eq!(days, [1, 19]);
+}
