+    assert_eq!(b.find_alarm_video.unwrap().file_handle, Some(7));
+}
+
+#[test]
+fn test_sd_download_request_serialises_like_the_app() {
+    let time = SdTime {
+        year: 2026,
+        month: 11,
+        day: 10,
+        hour: 13,
