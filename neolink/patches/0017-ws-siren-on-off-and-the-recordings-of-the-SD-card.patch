+
+    #[cfg(feature = "gstreamer")]
+    #[test]
+    fn a_download_becomes_an_mp4_with_the_cameras_frame_times() {
+        use neolink_core::bcmedia::model::{BcMediaAac, BcMediaIframe, BcMediaPframe, VideoType};
+        gstreamer::init().unwrap();
+        let frames = crate::rtsp::recorder::tests::encoded(
+            "videotestsrc num-buffers=30 ! video/x-raw,width=320,height=240,framerate=15/1 \
+             ! x264enc key-int-max=15 ! video/x-h264,stream-format=byte-stream,alignment=au \
+             ! appsink name=out sync=false",
+            30,
+        );
+        let sound = crate::rtsp::recorder::tests::encoded(
+            "audiotestsrc num-buffers=30 ! audio/x-raw,rate=16000,channels=1 ! avenc_aac \
+             ! aacparse ! audio/mpeg,stream-format=adts ! appsink name=out sync=false",
+            30,
+        );
+        // As a card download: a P-frame cut from before the first key frame, the counter near
+        // its wrap, the sound in between
+        let base = u32::MAX - 500_000;
+        #[allow(unused_mut)]
+        let mut packets = vec![BcMedia::Pframe(BcMediaPframe {
+            video_type: VideoType::H264,
+            microseconds: base - 66_666,
+            data: frames[1].clone(),
+        })];
+        for (i, frame) in frames.iter().enumerate() {
+            let microseconds = base.wrapping_add(i as u32 * 66_666);
+            packets.push(if i % 15 == 0 {
+                BcMedia::Iframe(BcMediaIframe {
+                    video_type: VideoType::H264,
+                    microseconds,
+                    time: None,
+                    data: frame.clone(),
+                })
+            } else {
+                BcMedia::Pframe(BcMediaPframe {
+                    video_type: VideoType::H264,
+                    microseconds,
+                    data: frame.clone(),
+                })
+            });
+            if let Some(a) = sound.get(i) {
+                packets.push(BcMedia::Aac(BcMediaAac { data: a.clone() }));
+            }
+        }
+        // The counter leaps by 23 minutes after the pre-recorded seconds (a Go Plus card recording)
+        for packet in packets.iter_mut().skip(10) {
+            if let BcMedia::Iframe(BcMediaIframe { microseconds, .. })
+            | BcMedia::Pframe(BcMediaPframe { microseconds, .. }) = packet
+            {
+                *microseconds = microseconds.wrapping_add(1_395_000_000);
+            }
+        }
+        let (kind, video, audio) = writer::timed(&packets);
+        assert!(matches!(kind, Some(VideoType::H264)));
+        assert_eq!(video.len(), 30, "the P-frame before the key frame is left out");
+        assert_eq!(video[29].pts, gstreamer::ClockTime::from_useconds(29 * 66_666));
+        assert_eq!(audio.len(), 30);
+        assert_eq!(
+            audio[1].pts - audio[0].pts,
+            gstreamer::ClockTime::from_nseconds(64_000_000)
+        );
+
+        let dir = std::env::temp_dir().join(format!("neolink-sd-mp4-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("132004-132006.mp4");
+        writer::write_mp4(&path, &packets).unwrap();
+        let (kinds, count) = crate::rtsp::recorder::tests::tracks(&path);
+        std::fs::remove_dir_all(&dir).unwrap();
+        assert!(kinds.contains(&"video/x-h264".to_string()), "{:?}", kinds);
+        assert!(kinds.contains(&"audio/mpeg".to_string()), "{:?}", kinds);
+        assert_eq!(count, 30);
+    }
+}
