+        <endTime><year>2026</year><month>9</month><day>19</day><hour>0</hour><minute>3</minute><second>48</second></endTime>
+        </FileInfo>
+        <FileInfo>
+        <channelId>0</channelId>
+        <handle>18</handle>
+        <name>0120260919000342</name>
+        <Id>/mnt/sda/Mp4Record/2026-09-19/RecM03_DST20260919_000342_000406_2B1E808_AF9DE.mp4</Id>
+        <streamType>mainStream</streamType>
