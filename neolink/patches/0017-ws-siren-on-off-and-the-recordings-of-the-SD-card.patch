+    let xml = BcXml {
+        cover_preview: Some(CoverPreview {
+            version: "1.1".to_string(),
+            channel_id: 0,
+            stream_type: "subStream".to_string(),
+            start_time: t,
+            end_time: SdTime { second: 28, ..t },
+            frame_list: FrameList { frame_no: 1 },
+        }),
+        ..Default::default()
+    };
+    let text = String::from_utf8(xml.serialize(vec![]).unwrap()).unwrap();
+    assert!(
+        text.contains("<CoverPreview version=\"1.1\"><channelId>0</channelId><streamType>subStream</streamType><startTime>"),
+        "{}",
+        text
+    );
+    assert!(text.ends_with("<frameList><frameNo>1</frameNo></frameList></CoverPreview></body>"), "{}", text);
+}
