diff --git a/crates/core/src/bc/de.rs b/crates/core/src/bc/de.rs
index 2aa9b77..1dd3f1d 100644
--- a/crates/core/src/bc/de.rs
+++ b/crates/core/src/bc/de.rs
@@ -184,9 +184,12 @@ fn bc_modern_msg<'a>(
                     // if if context.debug {
                     //     log::trace!("Binary: {:X?}", &processed_payload_buf[0..30]);
                     // }
-                    Some(BcPayloads::Binary(
-                        processed_payload_buf[0..(encrypted_len as usize)].to_vec(),
-                    ))
+                    // Only the first `encryptLen` bytes are encrypted (an SD card download
+                    // sends 1024 of a 17 kB chunk); the rest comes as it is
+                    let encrypted_len = (encrypted_len as usize).min(payload_buf.len());
+                    let mut data = processed_payload_buf[0..encrypted_len].to_vec();
+                    data.extend_from_slice(&payload_buf[encrypted_len..]);
+                    Some(BcPayloads::Binary(data))
                 }
                 _ => Some(BcPayloads::Binary(payload_buf.to_vec())),
             };
