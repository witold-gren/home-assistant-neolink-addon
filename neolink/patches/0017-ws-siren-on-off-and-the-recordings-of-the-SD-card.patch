+        "{}",
+        text
+    );
+    assert!(
+        text.contains("<startTime><year>2026</year><month>11</month><day>10</day><hour>13</hour><minute>20</minute><second>4</second></startTime>"),
+        "{}",
+        text
+    );
+}
+
+#[test]
+fn test_sd_file_list_page() {
