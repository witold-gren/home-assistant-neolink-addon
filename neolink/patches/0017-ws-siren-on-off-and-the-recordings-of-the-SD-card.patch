             .compat();
         FramedRead::new(async_read, BcMediaCodex::new(strict)).map(|frame| frame)
     }
+
+    /// The binary payload of a finite transfer (an SD card download): it ends at the first message
+    /// without a binary payload, the camera's end mark
+    pub fn payload_until_end(&'_ mut self) -> impl Stream<Item = IoResult<Vec<u8>>> + '_ {
+        (&mut self.rx)
+            .take_while(|x| {
+                !matches!(
+                    x,
+                    Ok(Bc {
+                        body: BcBody::ModernMsg(ModernMsg {
+                            payload: None | Some(BcPayloads::BcXml(_)),
+                            ..
+                        }),
+                        ..
+                    }) | Ok(Bc {
+                        body: BcBody::LegacyMsg(_),
+                        ..
+                    })
+                )
+            })
+            .filter_map(|x| match x {
+                Ok(Bc {
+                    body:
+                        BcBody::ModernMsg(ModernMsg {
+                            payload: Some(BcPayloads::Binary(data)),
+                            ..
+                        }),
+                    ..
+                }) => Some(Ok(data)),
+                Ok(_) => None,
+                Err(e) => Some(Err(IoError::new(ErrorKind::Other, e))),
+            })
+    }
+
+    /// The media of a finite transfer (see [Self::payload_until_end])
+    pub fn bcmedia_until_end(&'_ mut self, strict: bool) -> impl Stream<Item = Result<BcMedia>> + '_ {
+        let async_read = self.payload_until_end().into_async_read().compat();
+        FramedRead::new(async_read, BcMediaCodex::new(strict))
+    }
 }
diff --git a/crates/core/src/bc_protocol/sdcard.rs b/crates/core/src/bc_protocol/sdcard.rs
new file mode 100644
index 0000000..4790136
--- /dev/null
+++ b/crates/core/src/bc_protocol/sdcard.rs
@@ -0,0 +1,993 @@
+//! Recordings on the SD card: search and download
+//!
+//! Two generations of the messages, tried in this order:
+//! - newer (reolink_aio `search_vod_type` / `stream_mp4`, what Home Assistant uses for battery
+//!   cameras): search `findAlarmVideo` 272/273/274, download by time 143 (stopped by 144), the
+//!   reply ending with a message without a binary payload;
+//! - older (the Reolink app on cameras that answer 272 with 405, e.g. a Go Plus; wire format from
+//!   the decrypted captures in nodelink-js): search `FileInfoList` 14/15/16 with the host channel
+//!   (250) in the header, download by replaying one file (5, message number 0, stopped by 7), the
+//!   stream simply going quiet at the end.
+//!
+//! Either way the download is the camera's media stream (BcMedia), as fast as the link carries it.
+use super::{BcCamera, Error, Result, StreamKind};
+use crate::{
+    bc::{model::*, xml::*},
+    bcmedia::model::*,
+};
+use futures::stream::StreamExt;
+use std::time::Duration;
+use tokio::sync::mpsc::{channel, Receiver};
+use tokio::task::{self, JoinHandle};
+use tokio_util::sync::CancellationToken;
+
+/// Every kind of recording reolink_aio asks for
+const ALARM_TYPES: &str = "md, pir, io, people, face, vehicle, dog_cat, visitor, other, package, cry, crossline, intrusion, loitering, legacy, loss";
+/// The record types the Reolink app asks the older search for
+const RECORD_TYPES: &str = "manual, sched, io, md, people, face, vehicle, dog_cat, visitor, other, package, crossline, intrusion, loitering, legacy, loss";
+/// A search gives up after this many pages
+const MAX_PAGES: usize = 50;
+/// A full page of the older search; a shorter one is the last
+const PAGE_SIZE: usize = 40;
+/// The header channel of host messages (the older search)
+const HOST_CHANNEL: u8 = 250;
+/// A replay sends nothing at its end: this long without data ends it (a 4G relay pauses for
+/// seconds in the middle too)
+const REPLAY_IDLE: Duration = Duration::from_secs(15);
+/// The longest wait for the first data of a download
+const FIRST_DATA: Duration = Duration::from_secs(30);
+/// A cover picture is complete after this long without more of it
+const COVER_IDLE: Duration = Duration::from_secs(3);
+
+/// A recording on the SD card
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SdRecording {
+    /// Start of the event (the camera's local time)
+    pub start: SdTime,
+    /// End of the event
+    pub end: SdTime,
+    /// What started it, comma separated (md, pir, people, …)
+    pub kinds: String,
+    /// The camera's short name of it
+    pub name: String,
+    /// Full path on the card: present when it came from the older search, which downloads by it
+    pub id: Option<String>,
+    /// Size in bytes, when the camera tells
+    pub size: Option<u64>,
+    /// Full path of the sub stream file of the same event (older search): its first picture is a
+    /// small thumbnail
+    pub sub_id: Option<String>,
+}
+
+/// A download in progress: pull the media with [SdDownload::next]; dropping it stops the download
+pub struct SdDownload {
+    handle: Option<JoinHandle<Result<()>>>,
+    rx: Receiver<Result<BcMedia>>,
+    abort_handle: CancellationToken,
+}
+
+impl SdDownload {
+    /// The next packet, or `None` once the camera sent the whole recording
+    pub async fn next(&mut self) -> Option<Result<BcMedia>> {
+        match self.rx.recv().await {
+            Some(media) => Some(media),
+            None => {
+                // The task ended: report how, once
+                match self.handle.take()?.await {
+                    Ok(Ok(())) => None,
+                    Ok(Err(e)) => Some(Err(e)),
+                    Err(e) => Some(Err(Error::from(e))),
+                }
+            }
+        }
+    }
+}
+
+impl Drop for SdDownload {
+    fn drop(&mut self) {
+        self.abort_handle.cancel();
+        if let Some(handle) = self.handle.take() {
+            let _gt = tokio::runtime::Handle::current().enter();
+            tokio::task::spawn(async move {
+                let _ = handle.await;
+            });
+        }
+    }
+}
+
+fn stream_code(stream: StreamKind) -> u32 {
+    match stream {
+        StreamKind::Sub => 1,
+        _ => 0,
+    }
+}
+
+fn is_unsupported(e: &Error) -> bool {
+    matches!(e, Error::CameraServiceUnavailable { code, .. } if *code == 400 || *code == 405)
+}
+
+fn file_list(info: FileInfo) -> BcXml {
+    BcXml {
+        file_info_list: Some(FileInfoList {
+            version: xml_ver(),
+            file_info: vec![info],
+        }),
+        ..Default::default()
+    }
+}
+
+impl BcCamera {
+    /// The header channel of a channel's message as the Reolink app sends it (channel + 1)
+    fn app_channel(&self) -> u8 {
+        self.channel_id.wrapping_add(1)
+    }
+
+    fn sd_message(
+        &self,
+        msg_id: u32,
+        header_channel: u8,
+        msg_num: u16,
+        extension: bool,
+        xml: Option<BcXml>,
+    ) -> Bc {
+        Bc {
+            meta: BcMeta {
+                msg_id,
+                channel_id: header_channel,
+                msg_num,
+                response_code: 0,
+                stream_type: 0,
+                class: 0x6414,
+            },
+            body: BcBody::ModernMsg(ModernMsg {
+                extension: extension.then(|| Extension {
+                    channel_id: Some(self.channel_id),
+                    ..Default::default()
+                }),
+                payload: xml.map(BcPayloads::BcXml),
+            }),
+        }
+    }
+
+    async fn sd_request(
+        &self,
+        msg_id: u32,
+        header_channel: u8,
+        extension: bool,
+        xml: BcXml,
+    ) -> Result<Option<BcXml>> {
+        let msg_num = self.new_message_num();
+        let connection = self.get_connection();
+        let mut sub = connection.subscribe(msg_id, msg_num).await?;
+        sub.send(self.sd_message(msg_id, header_channel, msg_num, extension, Some(xml)))
+            .await?;
+        let msg = sub.recv().await?;
+        if msg.meta.response_code != 200 {
+            return Err(Error::CameraServiceUnavailable {
+                id: msg.meta.msg_id,
+                code: msg.meta.response_code,
+            });
+        }
+        Ok(match msg.body {
+            BcBody::ModernMsg(ModernMsg {
+                payload: Some(BcPayloads::BcXml(xml)),
+                ..
+            }) => Some(xml),
+            _ => None,
+        })
+    }
+
+    /// The recordings on the SD card from `start` to `end` (the camera's local time), oldest first
+    pub async fn sd_recordings(
+        &self,
+        start: SdTime,
+        end: SdTime,
+        stream: StreamKind,
+    ) -> Result<Vec<SdRecording>> {
+        let uid = self.uid().await?;
+        let mut found = vec![];
+        // The camera searches one day at a time; its calendar tells which days have any
+        let ranges = days(start, end);
+        let ranges = match self.sd_days(&uid, start, end).await {
+            Ok(with) => ranges
+                .into_iter()
+                .filter(|(from, _)| with.iter().any(|d| same_day(d, from)))
+                .collect(),
+            Err(e) => {
+                log::info!("SD card calendar (142) not answered ({e}), searching every day");
+                ranges
+            }
+        };
+        let mut newer = true;
+        for (start, end) in ranges {
+            if !newer {
+                found.extend(self.file_info_list(&uid, start, end, stream).await?);
+                continue;
+            }
+            let day = match self.find_alarm_videos(&uid, start, end, stream).await {
+                Ok(day) if !day.is_empty() => {
+                    log::info!(
+                        "SD card {}-{:02}-{:02}: {} recordings (findAlarmVideo)",
+                        start.year,
+                        start.month,
+                        start.day,
+                        day.len()
+                    );
+                    day
+                }
+                Ok(_) => self.file_info_list_logged(&uid, start, end, stream, "none").await?,
+                Err(e) if is_unsupported(&e) => {
+                    // The camera has only the older search: no need to ask again
+                    newer = false;
+                    self.file_info_list_logged(&uid, start, end, stream, &e.to_string())
+                        .await?
+                }
+                Err(e) => return Err(e),
+            };
+            found.extend(day);
+        }
+        Ok(merge_pages(found))
+    }
+
+    async fn file_info_list_logged(
+        &self,
+        uid: &str,
+        start: SdTime,
+        end: SdTime,
+        stream: StreamKind,
+        newer: &str,
+    ) -> Result<Vec<SdRecording>> {
+        let day = self.file_info_list(uid, start, end, stream).await?;
+        log::info!(
+            "SD card {}-{:02}-{:02}: {} recordings (FileInfoList; findAlarmVideo: {newer})",
+            start.year,
+            start.month,
+            start.day,
+            day.len()
+        );
+        Ok(day)
+    }
+
+    /// The days from `start` to `end` that have recordings, by the camera's calendar (142, a month
+    /// at a time)
+    pub async fn sd_days(&self, uid: &str, start: SdTime, end: SdTime) -> Result<Vec<SdTime>> {
+        let mut found = vec![];
+        for (from, to) in months(start, end) {
+            let request = BcXml {
+                day_records: Some(DayRecords {
+                    version: xml_ver(),
+                    start_time: Some(from),
+                    end_time: Some(to),
+                    list: Some(DayRecordList {
+                        records: vec![DayRecord {
+                            index: 0,
+                            channel_id: self.channel_id,
+                            uid: Some(uid.to_string()),
+                            day_types: None,
+                        }],
+                    }),
+                }),
+                ..Default::default()
+            };
+            let reply = self
+                .sd_request(MSG_ID_DAY_RECORDS, self.app_channel(), false, request)
+                .await?;
+            let days = reply
+                .and_then(|x| x.day_records)
+                .and_then(|d| d.list)
+                .map(|l| l.records)
+                .unwrap_or_default()
+                .into_iter()
+                .filter_map(|r| r.day_types)
+                .flat_map(|t| t.days);
+            found.extend(days.map(|d| SdTime {
+                day: d.index + 1,
+                hour: 0,
+                minute: 0,
+                second: 0,
+                ..from
+            }));
+        }
+        Ok(found)
+    }
+
+    /// The first picture of a recording, small: the camera's cover (298), or else the first
+    /// I-frame of a replay of the recording's sub stream file
+    pub async fn sd_thumbnail(&self, recording: &SdRecording) -> Result<BcMediaIframe> {
+        match self.sd_cover(recording, StreamKind::Sub).await {
+            Ok(frame) => Ok(frame),
+            Err(e) => {
+                let sub_id = match &recording.sub_id {
+                    Some(id) => id.clone(),
+                    None => self
+                        .sub_file_of(recording)
+                        .await?
+                        .ok_or(e)?,
+                };
+                log::debug!("No cover, replaying the start of {sub_id}");
+                let mut replay = self.sd_replay(&sub_id, &recording.name, StreamKind::Sub);
+                while let Some(packet) = replay.next().await {
+                    if let BcMedia::Iframe(frame) = packet? {
+                        // Dropping the replay stops it
+                        return Ok(frame);
+                    }
+                }
+                Err(Error::Other("The replay held no picture"))
+            }
+        }
+    }
+
+    /// The sub stream file of the event `recording` (the search of the main stream lists only its
+    /// own files): found by its start among that day's
+    async fn sub_file_of(&self, recording: &SdRecording) -> Result<Option<String>> {
+        let uid = self.uid().await?;
+        let day = SdTime {
+            hour: 0,
+            minute: 0,
+            second: 0,
+            ..recording.start
+        };
+        let end = SdTime {
+            hour: 23,
+            minute: 59,
+            second: 59,
+            ..day
+        };
+        let subs = self.file_info_list(&uid, day, end, StreamKind::Sub).await?;
+        Ok(subs
+            .into_iter()
+            .find(|s| s.start == recording.start)
+            .and_then(|s| s.id))
+    }
+
+    /// The first picture of a recording: one I-frame of `stream` (the sub stream is small)
+    pub async fn sd_cover(&self, recording: &SdRecording, stream: StreamKind) -> Result<BcMediaIframe> {
+        // The camera refuses a window of no length
+        let end = if recording.end > recording.start {
+            recording.end
+        } else {
+            SdTime {
+                second: recording.start.second.saturating_add(1).min(59),
+                ..recording.start
+            }
+        };
+        let msg_num = self.new_message_num();
+        let request = self.sd_message(
+            MSG_ID_COVER_PREVIEW,
+            self.app_channel(),
+            msg_num,
+            false,
+            Some(BcXml {
+                cover_preview: Some(CoverPreview {
+                    version: xml_ver(),
+                    channel_id: self.channel_id,
+                    stream_type: stream.to_string(),
+                    start_time: recording.start,
+                    end_time: end,
+                    frame_list: FrameList { frame_no: 1 },
+                }),
+                ..Default::default()
+            }),
+        );
+        let connection = self.get_connection();
+        let mut sub = connection.subscribe(MSG_ID_COVER_PREVIEW, msg_num).await?;
+        sub.send(request).await?;
+        let mut bytes = vec![];
+        let mut first = true;
+        let mut messages = 0;
+        loop {
+            let wait = if first { FIRST_DATA } else { COVER_IDLE };
+            let msg = match tokio::time::timeout(wait, sub.recv()).await {
+                Ok(msg) => msg?,
+                Err(_) if !first => break,
+                Err(_) => return Err(Error::Other("The camera sent no cover picture")),
+            };
+            if first && msg.meta.response_code != 200 {
+                return Err(Error::CameraServiceUnavailable {
+                    id: msg.meta.msg_id,
+                    code: msg.meta.response_code,
+                });
+            }
+            first = false;
+            messages += 1;
+            match msg.body {
+                BcBody::ModernMsg(ModernMsg {
+                    payload: Some(BcPayloads::Binary(data)),
+                    ..
+                }) => bytes.extend(data),
+                // The end of the picture
+                _ if !bytes.is_empty() => break,
+                _ => {}
+            }
+        }
+        let len = bytes.len();
+        let head: String = bytes.iter().take(8).map(|b| format!("{b:02x}")).collect();
+        first_iframe(bytes).await.ok_or_else(|| {
+            log::debug!("Cover: {messages} messages, {len} bytes, starting {head}");
+            Error::Other("The cover held no picture")
+        })
+    }
+
+    async fn find_alarm_videos(
+        &self,
+        uid: &str,
+        mut start: SdTime,
+        end: SdTime,
+        stream: StreamKind,
+    ) -> Result<Vec<SdRecording>> {
+        let channel = self.app_channel();
+        let mut found: Vec<SdRecording> = vec![];
+        for _ in 0..MAX_PAGES {
+            let open = BcXml {
+                find_alarm_video: Some(FindAlarmVideo {
+                    version: xml_ver(),
+                    channel_id: self.channel_id,
+                    uid: Some(uid.to_string()),
+                    logic_chn_bitmap: Some(255),
+                    stream_type: Some(stream_code(stream)),
+                    not_search_video: Some(0),
+                    start_time: Some(start),
+                    end_time: Some(end),
+                    alarm_type: Some(ALARM_TYPES.to_string()),
+                    ..Default::default()
+                }),
+                ..Default::default()
+            };
+            let handle = self
+                .sd_request(MSG_ID_FIND_REC_VIDEO_OPEN, channel, true, open)
+                .await?
+                .and_then(|x| x.find_alarm_video)
+                .and_then(|f| f.file_handle)
+                .ok_or(Error::Other("The SD card search gave no handle"))?;
+            let page_query = || BcXml {
+                find_alarm_video: Some(FindAlarmVideo {
+                    version: xml_ver(),
+                    channel_id: self.channel_id,
+                    file_handle: Some(handle),
+                    ..Default::default()
+                }),
+                ..Default::default()
+            };
+            let page = self
+                .sd_request(MSG_ID_FIND_REC_VIDEO, channel, true, page_query())
+                .await;
+            // Close the search whatever the page was
+            let _ = self
+                .sd_request(MSG_ID_FIND_REC_VIDEO_CLOSE, channel, true, page_query())
+                .await;
+            let Some(info) = page?.and_then(|x| x.alarm_video_info) else {
+                break;
+            };
+            let videos = info.list.map(|l| l.videos).unwrap_or_default();
+            let last = videos.last().map(|v| v.start_time);
+            found.extend(videos.into_iter().map(|v| SdRecording {
+                start: v.start_time,
+                end: v.end_time,
+                kinds: v.alarm_type,
+                name: v.file_name,
+                id: None,
+                size: None,
+                sub_id: None,
+            }));
+            match last {
+                // A page that is not the last: search on from its last recording
+                Some(last) if info.finished == 0 && last > start => start = last,
+                _ => break,
+            }
+        }
+        Ok(merge_pages(found))
+    }
+
+    async fn file_info_list(
+        &self,
+        uid: &str,
+        start: SdTime,
+        end: SdTime,
+        stream: StreamKind,
+    ) -> Result<Vec<SdRecording>> {
+        let open = file_list(FileInfo {
+            channel_id: Some(self.channel_id),
+            uid: Some(uid.to_string()),
+            search_ai_track: Some(1),
+            logic_chn_bitmap: Some(255),
+            stream_type: Some(stream.to_string()),
+            record_type: Some(RECORD_TYPES.to_string()),
+            start_time: Some(start),
+            end_time: Some(end),
+            ..Default::default()
+        });
+        let handle = self
+            .sd_request(MSG_ID_FILE_INFO_LIST_OPEN, HOST_CHANNEL, false, open)
+            .await?
+            .and_then(|x| x.file_info_list)
+            .and_then(|l| l.file_info.into_iter().find_map(|f| f.handle))
+            .ok_or(Error::Other("The SD card search gave no handle"))?;
+        let page_query = || {
+            file_list(FileInfo {
+                channel_id: Some(self.channel_id),
+                uid: Some(uid.to_string()),
+                search_ai_track: Some(1),
+                handle: Some(handle),
+                ..Default::default()
+            })
+        };
+        let mut files: Vec<FileInfo> = vec![];
+        let mut result = Ok(());
+        for _ in 0..MAX_PAGES {
+            match self
+                .sd_request(MSG_ID_FILE_INFO_LIST_GET, HOST_CHANNEL, false, page_query())
+                .await
+            {
+                Ok(page) => {
+                    let page = page
+                        .and_then(|x| x.file_info_list)
+                        .map(|l| l.file_info)
+                        .unwrap_or_default();
+                    let last = page.len() < PAGE_SIZE;
+                    files.extend(page);
+                    if last {
+                        break;
+                    }
+                }
+                // The camera answers 400 once there is nothing more
+                Err(Error::CameraServiceUnavailable { code: 400, .. }) => break,
+                Err(e) => {
+                    result = Err(e);
+                    break;
+                }
+            }
+        }
+        let _ = self
+            .sd_request(
+                MSG_ID_FILE_INFO_LIST_CLOSE,
+                HOST_CHANNEL,
+                false,
+                page_query(),
+            )
+            .await;
+        result?;
+        Ok(merge_pages(recordings_of(files, stream)))
+    }
+
+    /// Download one recording of [Self::sd_recordings]
+    pub async fn sd_download(
+        &self,
+        recording: &SdRecording,
+        stream: StreamKind,
+    ) -> Result<SdDownload> {
+        match &recording.id {
+            Some(id) => Ok(self.sd_replay(id, &recording.name, stream)),
+            None => {
+                self.sd_download_by_time(recording.start, recording.end, stream)
+                    .await
+            }
+        }
+    }
+
+    fn sd_replay(&self, id: &str, name: &str, stream: StreamKind) -> SdDownload {
+        // The app replays with message number 0
+        let request = self.sd_message(
+            MSG_ID_REPLAY,
+            self.app_channel(),
+            0,
+            true,
+            Some(file_list(FileInfo {
+                channel_id: Some(self.channel_id),
+                id: Some(id.to_string()),
+                support_sub: Some(stream_code(stream)),
+                play_speed: Some(1),
+                stream_type: Some(stream.to_string()),
+                ..Default::default()
+            })),
+        );
+        let stop = self.sd_message(
+            MSG_ID_REPLAY_STOP,
+            self.app_channel(),
+            self.new_message_num(),
+            false,
+            Some(file_list(FileInfo {
+                channel_id: Some(self.channel_id),
+                name: Some(name.to_string()),
+                stream_type: Some(stream.to_string()),
+                ..Default::default()
+            })),
+        );
+        self.sd_transfer(MSG_ID_REPLAY, 0, request, (MSG_ID_REPLAY_STOP, stop), true)
+    }
+
+    async fn sd_download_by_time(
+        &self,
+        start: SdTime,
+        end: SdTime,
+        stream: StreamKind,
+    ) -> Result<SdDownload> {
+        let uid = self.uid().await?;
+        let msg_num = self.new_message_num();
+        let request = self.sd_message(
+            MSG_ID_DOWNLOAD_BY_TIME,
+            self.app_channel(),
+            msg_num,
+            true,
+            Some(file_list(FileInfo {
+                channel_id: Some(self.channel_id),
+                uid: Some(uid),
+                logic_chn_bitmap: Some(255),
+                support_sub: Some(0),
+                stream_type: Some(stream.to_string()),
+                start_time: Some(start),
+                end_time: Some(end),
+                ..Default::default()
+            })),
+        );
+        let stop = self.sd_message(
+            MSG_ID_DOWNLOAD_BY_TIME_STOP,
+            self.app_channel(),
+            msg_num,
+            true,
+            None,
+        );
+        Ok(self.sd_transfer(
+            MSG_ID_DOWNLOAD_BY_TIME,
+            msg_num,
+            request,
+            (MSG_ID_DOWNLOAD_BY_TIME_STOP, stop),
+            false,
+        ))
+    }
+
+    /// Send `request` and pass on the media of its reply. `idle_ends`: the end is a pause in the
+    /// data (a replay), not a closing message. `stop` is sent when the transfer did not end by
+    /// itself, and after every replay, as the app does
+    fn sd_transfer(
+        &self,
+        msg_id: u32,
+        msg_num: u16,
+        request: Bc,
+        stop: (u32, Bc),
+        idle_ends: bool,
+    ) -> SdDownload {
+        let connection = self.get_connection();
+        let abort_handle = CancellationToken::new();
+        let abort = abort_handle.clone();
+        let (tx, rx) = channel(100);
+        let handle = task::spawn(async move {
+            let mut sub = connection.subscribe(msg_id, msg_num).await?;
+            sub.send(request).await?;
+            // The answer is the first message with a code: data of an earlier replay the camera
+            // still sends (code 0) is left out
+            let answer = tokio::time::timeout(FIRST_DATA, async {
+                loop {
+                    let msg = sub.recv().await?;
+                    if msg.meta.response_code != 0 {
+                        return Ok::<_, Error>(msg);
+                    }
+                }
+            })
+            .await
+            .map_err(|_| Error::Other("The camera did not answer the SD card download"))??;
+            if answer.meta.response_code != 200 {
+                return Err(Error::CameraServiceUnavailable {
+                    id: answer.meta.msg_id,
+                    code: answer.meta.response_code,
+                });
+            }
+            let complete = {
+                let mut media = sub.bcmedia_until_end(false);
+                let mut wait = FIRST_DATA;
+                tokio::select! {
+                    _ = abort.cancelled() => false,
+                    complete = async {
+                        loop {
+                            match tokio::time::timeout(wait, media.next()).await {
+                                Ok(Some(packet)) => {
+                                    if tx.send(packet).await.is_err() {
+                                        return false; // the reader went away
+                                    }
+                                    if idle_ends {
+                                        wait = REPLAY_IDLE;
+                                    }
+                                }
+                                Ok(None) => return true,
+                                // Quiet: the end of a replay, or a camera that stopped sending
+                                Err(_) => return idle_ends && wait == REPLAY_IDLE,
+                            }
+                        }
+                    } => complete,
+                }
+            };
+            if !complete || idle_ends {
+                let (stop_id, stop) = stop;
+                if let Ok(sub_stop) = connection.subscribe(stop_id, stop.meta.msg_num).await {
+                    let _ = sub_stop.send(stop).await;
+                }
+                // Let what the camera sent before it stopped go by, so the next download does not
+                // take it for its own
+                while let Ok(Some(_)) =
+                    tokio::time::timeout(Duration::from_secs(2), sub.bc_stream().next()).await
+                {}
+            }
+            if complete {
+                Ok(())
+            } else {
+                Err(Error::Other("The SD card download stopped early"))
+            }
+        });
+        SdDownload {
+            handle: Some(handle),
+            rx,
+            abort_handle,
+        }
+    }
+}
+
+/// The recordings of a page of the older search in the stream asked for (the card holds a main
+/// and a sub stream file of each event)
+fn recordings_of(files: Vec<FileInfo>, stream: StreamKind) -> Vec<SdRecording> {
+    let wanted = stream.to_string();
+    let sub = StreamKind::Sub.to_string();
+    // The sub stream file of each event, by its start
+    let subs: Vec<(SdTime, String)> = files
+        .iter()
+        .filter(|f| f.stream_type.as_deref() == Some(sub.as_str()))
+        .filter_map(|f| Some((f.start_time?, f.id.clone()?)))
+        .collect();
+    files
+        .into_iter()
+        .filter(|f| f.stream_type.as_deref().is_none_or(|s| s == wanted))
+        .filter_map(|f| {
+            let name = f
+                .name
+                .clone()
+                .filter(|n| !n.is_empty())
+                .or_else(|| f.id.clone())?;
+            let high = f.size_h.unwrap_or(0) << 32;
+            let start = f.start_time?;
+            Some(SdRecording {
+                start,
+                end: f.end_time?,
+                kinds: f.record_type.unwrap_or_default(),
+                name,
+                id: f.id,
+                size: f.size_l.map(|l| l + high),
+                sub_id: subs.iter().find(|(t, _)| *t == start).map(|(_, id)| id.clone()),
+            })
+        })
+        .collect()
+}
+
+/// The first I-frame of a BcMedia byte stream
+async fn first_iframe(bytes: Vec<u8>) -> Option<BcMediaIframe> {
+    let mut media = tokio_util::codec::FramedRead::new(
+        std::io::Cursor::new(bytes),
+        crate::bcmedia::codex::BcMediaCodex::new(false),
+    );
+    while let Some(packet) = media.next().await {
+        if let Ok(BcMedia::Iframe(frame)) = packet {
+            return Some(frame);
+        }
+    }
+    None
+}
+
+fn same_day(a: &SdTime, b: &SdTime) -> bool {
+    (a.year, a.month, a.day) == (b.year, b.month, b.day)
+}
+
+/// `start` to `end` cut into calendar months, each from its first to its last day
+fn months(start: SdTime, end: SdTime) -> Vec<(SdTime, SdTime)> {
+    let mut out = vec![];
+    let (mut year, mut month) = (start.year, start.month);
+    while (year, month) <= (end.year, end.month) {
+        let first = SdTime {
+            year,
+            month,
+            day: 1,
+            hour: 0,
+            minute: 0,
+            second: 0,
+        };
+        out.push((
+            first,
+            SdTime {
+                day: month_length(year, month),
+                hour: 23,
+                minute: 59,
+                second: 59,
+                ..first
+            },
+        ));
+        (year, month) = if month == 12 {
+            (year + 1, 1)
+        } else {
+            (year, month + 1)
+        };
+    }
+    out
+}
+
+fn month_length(year: u16, month: u8) -> u8 {
+    let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
+    match month {
+        2 if leap => 29,
+        2 => 28,
+        4 | 6 | 9 | 11 => 30,
+        _ => 31,
+    }
+}
+
+/// `start` to `end` cut into calendar days
+fn days(start: SdTime, end: SdTime) -> Vec<(SdTime, SdTime)> {
+    let mut out = vec![];
+    let mut from = start;
+    while from <= end {
+        let day_end = SdTime {
+            hour: 23,
+            minute: 59,
+            second: 59,
+            ..from
+        };
+        if day_end >= end {
+            out.push((from, end));
+            break;
+        }
+        out.push((from, day_end));
+        from = next_day(from);
+    }
+    out
+}
+
+fn next_day(t: SdTime) -> SdTime {
+    let length = month_length(t.year, t.month);
+    let (year, month, day) = if t.day < length {
+        (t.year, t.month, t.day + 1)
+    } else if t.month < 12 {
+        (t.year, t.month + 1, 1)
+    } else {
+        (t.year + 1, 1, 1)
+    };
+    SdTime {
+        year,
+        month,
+        day,
+        hour: 0,
+        minute: 0,
+        second: 0,
+    }
+}
+
+/// Recordings of all pages, oldest first, each once (a page that is searched on from its last
+/// recording repeats that one)
+fn merge_pages(mut found: Vec<SdRecording>) -> Vec<SdRecording> {
+    found.sort_by(|a, b| (a.start, &a.name).cmp(&(b.start, &b.name)));
+    found.dedup_by(|a, b| a.start == b.start && a.name == b.name);
+    found
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn at(hour: u8, minute: u8) -> SdTime {
+        SdTime {
+            year: 2026,
+            month: 11,
+            day: 10,
+            hour,
+            minute,
+            second: 0,
+        }
+    }
+
+    fn recording(name: &str, hour: u8, minute: u8) -> SdRecording {
+        SdRecording {
+            start: at(hour, minute),
+            end: at(hour, minute + 1),
+            kinds: "md".to_string(),
+            name: name.to_string(),
+            id: None,
+            size: None,
+            sub_id: None,
+        }
+    }
+
+    #[test]
+    fn pages_are_merged_oldest_first_without_repeats() {
+        let merged = merge_pages(vec![
+            recording("b", 14, 0),
+            recording("c", 15, 0),
+            recording("a", 13, 20),
+            recording("c", 15, 0),
+        ]);
+        let names: Vec<&str> = merged.iter().map(|v| v.name.as_str()).collect();
+        assert_eq!(names, ["a", "b", "c"]);
+    }
+
+    #[test]
+    fn times_order_like_the_clock() {
+        assert!(at(9, 59) < at(10, 0));
+        assert!(SdTime { day: 9, ..at(23, 0) } < at(0, 0));
+    }
+
+    #[test]
+    fn the_sub_stream_is_searched_as_1() {
+        assert_eq!(stream_code(StreamKind::Sub), 1);
+        assert_eq!(stream_code(StreamKind::Main), 0);
+    }
+
+    #[test]
+    fn the_older_search_keeps_the_stream_asked_for() {
+        let file = |stream: &str, name: &str| FileInfo {
+            name: Some(name.to_string()),
+            id: Some(format!("/mnt/sda/Mp4Record/2026-11-10/{name}.mp4")),
+            stream_type: Some(stream.to_string()),
+            record_type: Some("pir".to_string()),
+            size_l: Some(10),
+            size_h: Some(1),
+            start_time: Some(at(13, 20)),
+            end_time: Some(at(13, 21)),
+            ..Default::default()
+        };
+        let found = recordings_of(
+            vec![file("subStream", "s"), file("mainStream", "m")],
+            StreamKind::Main,
+        );
+        assert_eq!(found.len(), 1);
+        assert_eq!(found[0].name, "m");
+        assert_eq!(found[0].size, Some(10 + (1 << 32)));
+        assert!(found[0].id.as_deref().unwrap().ends_with("m.mp4"));
+        // The sub stream file of the same event, for a thumbnail
+        assert!(found[0].sub_id.as_deref().unwrap().ends_with("s.mp4"));
+    }
+
+    #[test]
+    fn a_range_is_searched_day_by_day() {
+        let start = SdTime {
+            day: 9,
+            ..at(15, 0)
+        };
+        let ranges = days(start, at(14, 30));
+        assert_eq!(ranges.len(), 2);
+        assert_eq!(ranges[0], (start, SdTime { day: 9, minute: 59, second: 59, ..at(23, 0) }));
+        assert_eq!(ranges[1], (SdTime { day: 10, ..at(0, 0) }, at(14, 30)));
+        let new_year = SdTime { year: 2026, month: 12, day: 31, hour: 0, minute: 0, second: 0 };
+        assert_eq!(next_day(new_year), SdTime { year: 2027, month: 1, day: 1, hour: 0, minute: 0, second: 0 });
+        assert_eq!(next_day(SdTime { year: 2028, month: 2, day: 28, ..new_year }).day, 29);
+    }
+
+    #[test]
+    fn a_range_is_asked_month_by_month() {
+        let start = SdTime { month: 10, day: 15, ..at(9, 0) };
+        let end = SdTime { year: 2027, month: 1, day: 3, ..at(9, 0) };
+        let m = months(start, end);
+        assert_eq!(m.len(), 4);
+        assert_eq!((m[0].0.month, m[0].0.day, m[0].1.day), (10, 1, 31));
+        assert_eq!((m[1].0.month, m[1].1.day), (11, 30));
+        assert_eq!((m[3].0.year, m[3].0.month), (2027, 1));
+    }
+
+    #[tokio::test]
+    async fn the_cover_is_the_first_iframe_of_the_reply() {
+        // The cover a standalone E1 sends (nodelink-js fixture, picture zeroed): a stream header,
+        // then one H.264 I-frame
+        let bytes = std::fs::read(concat!(
+            env!("CARGO_MANIFEST_DIR"),
+            "/src/bc/samples/coverpreview-298-payload.bin"
+        ))
+        .unwrap();
+        let frame = first_iframe(bytes).await.expect("an I-frame");
+        assert!(matches!(frame.video_type, VideoType::H264));
+        assert_eq!(&frame.data[0..5], &[0, 0, 0, 1, 0x67]);
+    }
+
+    #[test]
+    fn unsupported_searches_fall_back() {
+        assert!(is_unsupported(&Error::CameraServiceUnavailable {
+            id: 272,
+            code: 405
+        }));
+        assert!(!is_unsupported(&Error::CameraServiceUnavailable {
+            id: 272,
+            code: 500
+        }));
+    }
+}
