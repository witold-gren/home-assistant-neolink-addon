new file mode 100644
index 0000000..e53660a
--- /dev/null
+++ b/src/sdcard.rs
@@ -0,0 +1,740 @@
+//! Copies the recordings on a camera's SD card to the recording folder
+//!
+//! A sync searches the card for a time range (`BcCamera::sd_recordings`), leaves out what is in
+//! `<dir>/<camera>/<YYYY-MM-DD>/HHMMSS-HHMMSS.mp4` already (the name of the live-view recordings,
+//! from the camera's own start and end of the event) and downloads the rest, one by one. A file
+//! is written as `….mp4.part` and renamed once whole, so a crash never leaves a broken recording
+//! that a later sync would take for done.
+use anyhow::{anyhow, Context, Result};
+use chrono::{Datelike, Local, NaiveDateTime, Timelike};
+use neolink_core::{
+    bc::xml::SdTime,
+    bc_protocol::{SdRecording, StreamKind},
+    bcmedia::model::BcMedia,
+};
+use std::{
+    collections::{HashMap, HashSet},
+    path::{Path, PathBuf},
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+
+use crate::common::NeoInstance;
+
+/// Longest a single recording may take to download. Only a backstop: a download ends when its
+/// data stops for a while (the core's idle limit), so a long recording over a slow 4G link that
+/// keeps coming is never cut (one of 22 MB took 4.5 minutes)
+const DOWNLOAD_TIMEOUT: Duration = Duration::from_secs(30 * 60);
+/// Longest a search of the card may take (a year of it took about 4 minutes over 4G)
+const SEARCH_TIMEOUT: Duration = Duration::from_secs(15 * 60);
+/// Longest a cover may take
+const COVER_TIMEOUT: Duration = Duration::from_secs(60);
+/// Suffix of a file still being written
+const PART: &str = ".part";
+
+static SYNCING: Mutex<Option<HashSet<String>>> = Mutex::new(None);
+
+/// One operation on a camera's card at a time: a search, a cover and a download all use the
+/// camera's replay channel (message 5, number 0) or its search handle, and interleaved they mixed
+/// one's data into the other's answer
+static CARD_LOCKS: Mutex<Option<HashMap<String, Arc<tokio::sync::Mutex<()>>>>> = Mutex::new(None);
+
+fn card_lock(camera: &str) -> Arc<tokio::sync::Mutex<()>> {
+    CARD_LOCKS
+        .lock()
+        .map(|mut locks| {
+            locks
+                .get_or_insert_with(HashMap::new)
+                .entry(camera.to_string())
+                .or_default()
+                .clone()
+        })
+        .unwrap_or_default()
+}
+
+/// Claim the sync of `camera`: false while another sync of it runs
+pub(crate) fn claim(camera: &str) -> bool {
+    SYNCING
+        .lock()
+        .map(|mut s| s.get_or_insert_with(HashSet::new).insert(camera.to_string()))
+        .unwrap_or(false)
+}
+
+/// Let the sync of `camera` go
+pub(crate) fn release(camera: &str) {
+    if let Ok(mut s) = SYNCING.lock() {
+        if let Some(set) = s.as_mut() {
+            set.remove(camera);
+        }
+    }
+}
+
+pub(crate) fn sd_time(t: &NaiveDateTime) -> SdTime {
+    SdTime {
+        year: t.year() as u16,
+        month: t.month() as u8,
+        day: t.day() as u8,
+        hour: t.hour() as u8,
+        minute: t.minute() as u8,
+        second: t.second() as u8,
+    }
+}
+
+/// The range from `hours` ago to a minute from now, in local time like the camera's clock
+pub(crate) fn last_hours(hours: u64) -> (SdTime, SdTime) {
+    let now = Local::now().naive_local();
+    let start = now - chrono::Duration::hours(hours as i64);
+    let end = now + chrono::Duration::minutes(1);
+    (sd_time(&start), sd_time(&end))
+}
+
+/// `YYYY-MM-DD/HHMMSS-HHMMSS.mp4` of a recording on the card
+pub(crate) fn relative_path(video: &SdRecording) -> PathBuf {
+    let s = &video.start;
+    let e = &video.end;
+    PathBuf::from(format!("{:04}-{:02}-{:02}", s.year, s.month, s.day)).join(format!(
+        "{:02}{:02}{:02}-{:02}{:02}{:02}.mp4",
+        s.hour, s.minute, s.second, e.hour, e.minute, e.second
+    ))
+}
+
+/// The recordings of `found` that `dir` (the camera's folder) does not hold yet
+pub(crate) fn missing(dir: &Path, found: &[SdRecording]) -> Vec<SdRecording> {
+    found
+        .iter()
+        .filter(|v| !dir.join(relative_path(v)).exists())
+        .cloned()
+        .collect()
+}
+
+/// The cover thumbnail of a recording: `<thumbs>/<YYYY-MM-DD>/HHMMSS-HHMMSS.jpg`
+pub(crate) fn thumbnail_path(thumbs: &Path, video: &SdRecording) -> PathBuf {
+    thumbs.join(relative_path(video).with_extension("jpg"))
+}
+
+/// Fetch the cover of a recording from the card (its first picture of the sub stream, a few
+/// dozen kB) and keep it as a JPEG thumbnail
+pub(crate) async fn fetch_thumbnail(
+    name: &str,
+    camera: &NeoInstance,
+    thumbs: &Path,
+    video: &SdRecording,
+) -> Result<PathBuf> {
+    let lock = card_lock(name);
+    let _card = lock.lock().await;
+    let frame = tokio::time::timeout(
+        COVER_TIMEOUT,
+        camera.run_task(move |cam| {
+            let video = video.clone();
+            Box::pin(async move { Ok(cam.sd_thumbnail(&video).await?) })
+        }),
+    )
+    .await
+    .map_err(|_| anyhow!("the cover did not come in time"))??;
+    let jpeg = tokio::task::spawn_blocking(move || writer::jpeg(&frame.data, frame.video_type))
+        .await??;
+    let path = thumbnail_path(thumbs, video);
+    if let Some(day) = path.parent() {
+        std::fs::create_dir_all(day).with_context(|| format!("Cannot create {}", day.display()))?;
+    }
+    std::fs::write(&path, jpeg).with_context(|| format!("Cannot write {}", path.display()))?;
+    Ok(path)
+}
+
+/// Remove files left half-written by a crash
+pub(crate) fn remove_parts(dir: &Path) {
+    let Ok(days) = std::fs::read_dir(dir) else {
+        return;
+    };
+    for day in days.flatten() {
+        let Ok(files) = std::fs::read_dir(day.path()) else {
+            continue;
+        };
+        for file in files.flatten() {
+            if file.file_name().to_string_lossy().ends_with(PART) {
+                let _ = std::fs::remove_file(file.path());
+            }
+        }
+    }
+}
+
+/// The recordings on the card of `camera` in `range`
+pub(crate) async fn recordings(
+    name: &str,
+    camera: &NeoInstance,
+    range: (SdTime, SdTime),
+    stream: StreamKind,
+) -> Result<Vec<SdRecording>> {
+    let lock = card_lock(name);
+    let _card = lock.lock().await;
+    tokio::time::timeout(
+        SEARCH_TIMEOUT,
+        camera.run_task(move |cam| {
+            Box::pin(async move { Ok(cam.sd_recordings(range.0, range.1, stream).await?) })
+        }),
+    )
+    .await
+    .map_err(|_| anyhow!("the SD card search did not answer in time"))?
+}
+
+/// Download one recording whole, as the camera's media packets
+async fn download(
+    name: &str,
+    camera: &NeoInstance,
+    video: &SdRecording,
+    stream: StreamKind,
+) -> Result<Vec<BcMedia>> {
+    let lock = card_lock(name);
+    let _card = lock.lock().await;
+    tokio::time::timeout(
+        DOWNLOAD_TIMEOUT,
+        camera.run_task(move |cam| {
+            let video = video.clone();
+            Box::pin(async move {
+                let mut download = cam.sd_download(&video, stream).await?;
+                let mut packets = vec![];
+                while let Some(packet) = download.next().await {
+                    packets.push(packet?);
+                }
+                Ok(packets)
+            })
+        }),
+    )
+    .await
+    .map_err(|_| anyhow!("the download did not finish within {DOWNLOAD_TIMEOUT:?}"))?
+}
+
+/// What a download holds, for the log: packets by kind, bytes and how the first frame starts
+pub(crate) fn describe(packets: &[BcMedia]) -> String {
+    let (mut info, mut i, mut p, mut aac, mut adpcm, mut bytes) = (0, 0, 0, 0, 0, 0);
+    let mut first: Option<&[u8]> = None;
+    for packet in packets {
+        match packet {
+            BcMedia::InfoV1(_) | BcMedia::InfoV2(_) => info += 1,
+            BcMedia::Iframe(f) => {
+                i += 1;
+                bytes += f.data.len();
+                first.get_or_insert(&f.data);
+            }
+            BcMedia::Pframe(f) => {
+                p += 1;
+                bytes += f.data.len();
+            }
+            BcMedia::Aac(a) => {
+                aac += 1;
+                bytes += a.data.len();
+            }
+            BcMedia::Adpcm(a) => {
+                adpcm += 1;
+                bytes += a.data.len();
+            }
+        }
+    }
+    let head: String = first
+        .map(|d| d.iter().take(12).map(|b| format!("{b:02x}")).collect())
+        .unwrap_or_default();
+    format!("{info} info, {i} I, {p} P, {aac} AAC, {adpcm} ADPCM, {bytes} bytes, first I {head}")
+}
+
+/// A download that could not be written is kept as raw video for a look (`.sd-debug/`)
+fn dump(dir: &Path, video: &SdRecording, packets: &[BcMedia]) {
+    let debug = dir.join(".sd-debug");
+    if std::fs::create_dir_all(&debug).is_err() {
+        return;
+    }
+    let mut raw = vec![];
+    for packet in packets {
+        match packet {
+            BcMedia::Iframe(f) => raw.extend_from_slice(&f.data),
+            BcMedia::Pframe(f) => raw.extend_from_slice(&f.data),
+            _ => {}
+        }
+    }
+    let name = relative_path(video)
+        .to_string_lossy()
+        .replace(['/', '\\'], "_")
+        .replace(".mp4", ".video");
+    let _ = std::fs::write(debug.join(name), raw);
+}
+
+/// Download `video` into the camera's folder `dir`; returns the file
+pub(crate) async fn copy(
+    name: &str,
+    camera: &NeoInstance,
+    dir: &Path,
+    video: &SdRecording,
+    stream: StreamKind,
+) -> Result<PathBuf> {
+    let target = dir.join(relative_path(video));
+    let started = std::time::Instant::now();
+    let packets = download(name, camera, video, stream).await?;
+    log::info!(
+        "{}: downloaded {} in {:.1} s: {}",
+        video.name,
+        relative_path(video).display(),
+        started.elapsed().as_secs_f32(),
+        describe(&packets)
+    );
+    if let Some(day) = target.parent() {
+        std::fs::create_dir_all(day).with_context(|| format!("Cannot create {}", day.display()))?;
+    }
+    let part = PathBuf::from(format!("{}{PART}", target.display()));
+    let (written, packets) = {
+        let part = part.clone();
+        tokio::task::spawn_blocking(move || (writer::write_mp4(&part, &packets), packets)).await?
+    };
+    if let Err(e) = written {
+        let _ = std::fs::remove_file(&part);
+        dump(dir, video, &packets);
+        return Err(e);
+    }
+    std::fs::rename(&part, &target)
+        .with_context(|| format!("Cannot rename {}", part.display()))?;
+    Ok(target)
+}
+
+#[cfg(feature = "gstreamer")]
+mod writer {
+    //! The packets of a download to an mp4, with the camera's own frame times (the download comes
+    //! faster than real time, so the clock of arrival would squeeze it)
+    use anyhow::{anyhow, Context, Result};
+    use gstreamer::{prelude::*, Caps, ClockTime, Element, ElementFactory, MessageView, Pipeline};
+    use gstreamer_app::{AppSrc, AppStreamType};
+    use neolink_core::bcmedia::model::{BcMedia, VideoType};
+    use std::path::Path;
+
+    /// AAC sample rates by the ADTS index
+    const AAC_RATES: [u32; 13] = [
+        96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350,
+    ];
+    const FINISH_TIMEOUT_S: u64 = 30;
+
+    fn element(kind: &str) -> Result<Element> {
+        ElementFactory::make(kind)
+            .build()
+            .with_context(|| format!("GStreamer element {kind} is missing"))
+    }
+
+    fn appsrc(caps: Caps) -> Result<AppSrc> {
+        let src = element("appsrc")?
+            .dynamic_cast::<AppSrc>()
+            .map_err(|_| anyhow!("Cannot cast to appsrc"))?;
+        src.set_caps(Some(&caps));
+        src.set_format(gstreamer::Format::Time);
+        src.set_stream_type(AppStreamType::Stream);
+        Ok(src)
+    }
+
+    /// Sample rate of an ADTS frame
+    pub(crate) fn adts_rate(frame: &[u8]) -> Option<u32> {
+        if frame.len() < 7 || frame[0] != 0xFF || frame[1] & 0xF0 != 0xF0 {
+            return None;
+        }
+        AAC_RATES.get(((frame[2] >> 2) & 0x0F) as usize).copied()
+    }
+
+    /// The codec of an Annex B frame, by its first NAL unit: the camera's media header can say
+    /// H.264 for an H.265 recording (a Go Plus main stream on the card)
+    pub(crate) fn codec(frame: &[u8]) -> Option<VideoType> {
+        let start = frame.windows(3).position(|w| w == [0, 0, 1])? + 3;
+        let header = *frame.get(start)?;
+        match (header >> 1) & 0x3F {
+            // VPS, SPS, PPS, IDR of H.265
+            32..=34 | 19 | 20 => Some(VideoType::H265),
+            _ => match header & 0x1F {
+                // SPS, PPS, IDR of H.264
+                7 | 8 | 5 => Some(VideoType::H264),
+                _ => None,
+            },
+        }
+    }
+
+    /// A frame with its time from the start of the download
+    pub(crate) struct Timed<'a> {
+        pub(crate) pts: ClockTime,
+        pub(crate) data: &'a [u8],
+    }
+
+    /// A step between two frames longer than this (or backwards) is the camera's counter jumping,
+    /// not time passing: a Go Plus recording starts with its pre-recorded seconds, after which the
+    /// counter leaps by minutes
+    const MAX_STEP_US: u32 = 2_000_000;
+    /// The step of a frame when the camera's counter cannot tell (15 fps)
+    const FRAME_STEP_US: u32 = 66_666;
+
+    /// Video frames timed by the camera's microsecond counter (it wraps at 2^32; a jump is taken
+    /// as one frame), AAC frames timed by their samples from the video frame they first follow
+    pub(crate) fn timed(packets: &[BcMedia]) -> (Option<VideoType>, Vec<Timed<'_>>, Vec<Timed<'_>>) {
+        let mut kind = None;
+        let mut first_us: Option<u32> = None;
+        let mut previous_us: Option<u32> = None;
+        let mut step_us = FRAME_STEP_US;
+        let mut last_video = ClockTime::ZERO;
+        let mut video = vec![];
+        let mut audio = vec![];
+        let mut audio_next: Option<ClockTime> = None;
+        for packet in packets {
+            let (video_type, us, data) = match packet {
+                BcMedia::Iframe(f) => (f.video_type, f.microseconds, &f.data),
+                BcMedia::Pframe(f) => (f.video_type, f.microseconds, &f.data),
+                BcMedia::Aac(a) => {
+                    let Some(rate) = adts_rate(&a.data) else {
+                        continue;
+                    };
+                    // Sound before the first picture has nothing to stand on
+                    if first_us.is_none() {
+                        continue;
+                    }
+                    let pts = audio_next.unwrap_or(last_video);
+                    audio.push(Timed { pts, data: &a.data });
+                    audio_next = Some(pts + ClockTime::from_nseconds(1024 * 1_000_000_000 / rate as u64));
+                    continue;
+                }
+                _ => continue,
+            };
+            // Start at a key frame: a P-frame before it cannot be shown
+            if first_us.is_none() && !matches!(packet, BcMedia::Iframe(_)) {
+                continue;
+            }
+            kind.get_or_insert(codec(data).unwrap_or(video_type));
+            first_us.get_or_insert(us);
+            if let Some(previous) = previous_us {
+                let step = us.wrapping_sub(previous);
+                if step > 0 && step <= MAX_STEP_US {
+                    step_us = step;
+                }
+                last_video += ClockTime::from_useconds(step_us as u64);
+            }
+            previous_us = Some(us);
+            video.push(Timed {
+                pts: last_video,
+                data,
+            });
+        }
+        (kind, video, audio)
+    }
+
+    fn push(src: &AppSrc, frame: &Timed) -> Result<()> {
+        let mut buffer = gstreamer::Buffer::from_slice(frame.data.to_vec());
+        {
+            let buffer = buffer.get_mut().expect("a new buffer");
+            buffer.set_pts(frame.pts);
+            buffer.set_dts(frame.pts);
+        }
+        src.push_buffer(buffer)
+            .map(|_| ())
+            .map_err(|e| anyhow!("The mp4 writer stopped: {e:?}"))
+    }
+
+    /// One I-frame (Annex B) as a JPEG
+    pub(crate) fn jpeg(frame: &[u8], labelled: VideoType) -> Result<Vec<u8>> {
+        let (caps, parser, decoder) = match codec(frame).unwrap_or(labelled) {
+            VideoType::H264 => ("video/x-h264", "h264parse", "avdec_h264"),
+            VideoType::H265 => ("video/x-h265", "h265parse", "avdec_h265"),
+        };
+        let pipeline = Pipeline::new();
+        let src = appsrc(Caps::builder(caps).field("stream-format", "byte-stream").build())?;
+        let elements = [
+            element(parser)?,
+            element(decoder)?,
+            element("videoconvert")?,
+            element("jpegenc")?,
+        ];
+        let sink = element("appsink")?
+            .dynamic_cast::<gstreamer_app::AppSink>()
+            .map_err(|_| anyhow!("Cannot cast to appsink"))?;
+        pipeline.add(src.upcast_ref::<Element>())?;
+        pipeline.add_many(&elements)?;
+        pipeline.add(sink.upcast_ref::<Element>())?;
+        let mut chain: Vec<&Element> = vec![src.upcast_ref()];
+        chain.extend(elements.iter());
+        chain.push(sink.upcast_ref());
+        Element::link_many(chain)?;
+        pipeline
+            .set_state(gstreamer::State::Playing)
+            .context("The thumbnail pipeline does not start")?;
+        let mut buffer = gstreamer::Buffer::from_slice(frame.to_vec());
+        buffer
+            .get_mut()
+            .expect("a new buffer")
+            .set_pts(ClockTime::ZERO);
+        let pushed = src.push_buffer(buffer);
+        let _ = src.end_of_stream();
+        let sample = sink.try_pull_sample(ClockTime::from_seconds(10));
+        let _ = pipeline.set_state(gstreamer::State::Null);
+        pushed.map_err(|e| anyhow!("The thumbnail pipeline stopped: {e:?}"))?;
+        let sample = sample.ok_or_else(|| anyhow!("The cover could not be decoded"))?;
+        let buffer = sample.buffer().ok_or_else(|| anyhow!("An empty thumbnail"))?;
+        let map = buffer.map_readable()?;
+        Ok(map.to_vec())
+    }
+
+    pub(crate) fn write_mp4(path: &Path, packets: &[BcMedia]) -> Result<()> {
+        let (kind, video, audio) = timed(packets);
+        let kind = kind.ok_or_else(|| anyhow!("the download holds no key frame"))?;
+        let pipeline = Pipeline::new();
+        let (caps, parser) = match kind {
+            VideoType::H264 => ("video/x-h264", "h264parse"),
+            VideoType::H265 => ("video/x-h265", "h265parse"),
+        };
+        let video_src = appsrc(Caps::builder(caps).field("stream-format", "byte-stream").build())?;
+        let video_parse = element(parser)?;
+        let video_queue = element("queue")?;
+        let mux = element("mp4mux")?;
+        let sink = element("filesink")?;
+        sink.set_property("location", path.to_string_lossy().to_string());
+        pipeline.add_many([video_src.upcast_ref(), &video_parse, &video_queue, &mux, &sink])?;
+        Element::link_many([video_src.upcast_ref(), &video_parse, &video_queue, &mux, &sink])?;
+        let audio_src = if audio.is_empty() {
+            None
+        } else {
+            let src = appsrc(
+                Caps::builder("audio/mpeg")
+                    .field("mpegversion", 4i32)
+                    .field("stream-format", "adts")
+                    .build(),
+            )?;
+            let parse = element("aacparse")?;
+            let queue = element("queue")?;
+            pipeline.add_many([src.upcast_ref(), &parse, &queue])?;
+            Element::link_many([src.upcast_ref(), &parse, &queue, &mux])?;
+            Some(src)
+        };
+        pipeline
+            .set_state(gstreamer::State::Playing)
+            .context("The mp4 writer does not start")?;
+        let fed = (|| -> Result<()> {
+            for frame in &video {
+                push(&video_src, frame)?;
+            }
+            let _ = video_src.end_of_stream();
+            if let Some(src) = audio_src.as_ref() {
+                for frame in &audio {
+                    push(src, frame)?;
+                }
+                let _ = src.end_of_stream();
+            }
+            Ok(())
+        })();
+        let ended = pipeline.bus().and_then(|bus| {
+            bus.timed_pop_filtered(
+                ClockTime::from_seconds(FINISH_TIMEOUT_S),
+                &[gstreamer::MessageType::Eos, gstreamer::MessageType::Error],
+            )
+        });
+        let _ = pipeline.set_state(gstreamer::State::Null);
+        fed?;
+        match ended {
+            Some(message) => match message.view() {
+                MessageView::Error(e) => Err(anyhow!("The mp4 writer failed: {}", e.error())),
+                _ => Ok(()),
+            },
+            None => Err(anyhow!("The mp4 writer did not finish in time")),
+        }
+    }
+}
+
