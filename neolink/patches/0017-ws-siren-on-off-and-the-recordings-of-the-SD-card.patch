+//! The SD card over the WebSocket: the list of its recordings and copies of them
+//!
+//! - `sd_recordings`: the list kept from the last search, at once; `refresh: true` searches the
+//!   card again in the background (`days`, default 365, by its calendar) and then fetches the
+//!   cover thumbnails of the newest recordings (`GET /sd_thumbnail/{camera}/{day}/{HHMMSS-HHMMSS}.jpg`);
+//!   `thumbnails: [files]` asks for the covers of older ones (e.g. those a client shows).
+//! - `sd_sync`: copies chosen recordings (`files`, as the list names them) or those of the last
+//!   `hours` that the folder lacks (`latest`: only the newest), one after another; more can be
+//!   asked while it runs. State `sd_sync` tells the progress, `pending` the files still to copy.
+//!
+//! - `sd_auto` (`on`): copy the newest recording by itself `SD_AUTO_DELAY` after each motion
+//!   notification (the camera ends its recording meanwhile); kept across restarts, off by default.
+//!   State `sd_auto` (None without a recording folder).
+//!
+//! Nothing on the card is ever deleted.
+use super::{authorized, now, update, App, AuthQuery, SdSyncState};
+use crate::{common::NeoInstance, sdcard, AnyResult};
+use anyhow::anyhow;
+use axum::{
+    extract::{Path, Query, State},
+    http::{header, HeaderMap, StatusCode},
+    response::{IntoResponse, Response},
+};
+use neolink_core::bc_protocol::SdRecording;
+use serde_json::{json, Value};
+use std::{
+    collections::{HashMap, HashSet, VecDeque},
+    path::PathBuf,
+    sync::Mutex,
+};
+
+/// How far back a refresh searches when no `days` are given
+const LIST_DAYS: u64 = 365;
+/// Thumbnails stop after this many covers in a row could not be fetched
+const COVER_FAILURES: usize = 3;
+/// How long after a motion notification the newest recording is copied (`sd_auto`): the camera
+/// records for the event and its post-record time first
+const SD_AUTO_DELAY: std::time::Duration = std::time::Duration::from_secs(5 * 60);
+/// After a search the covers of this many newest recordings are fetched; older ones only when a
+/// client asks for them (`thumbnails` of `sd_recordings`), as each wakes the camera
+const NEWEST_COVERS: usize = 48;
+
+/// The card of each camera as last seen, and what is being done with it
+#[derive(Default)]
+pub(super) struct SdShared {
+    lists: Mutex<HashMap<String, CardList>>,
+    queues: Mutex<HashMap<String, VecDeque<SdRecording>>>,
+    refreshing: Mutex<HashSet<String>>,
+    thumbnailing: Mutex<HashSet<String>>,
+    /// Covers asked for by clients, fetched before the newest ones
+    wanted_covers: Mutex<HashMap<String, Vec<String>>>,
+    /// Cameras with an automatic copy waiting for its delay
+    auto_waiting: Mutex<HashSet<String>>,
+}
+
+#[derive(Clone, Default)]
+struct CardList {
+    /// Unix time (s) of the search
+    updated: Option<u64>,
+    recordings: Vec<SdRecording>,
+    error: Option<String>,
+}
+
+/// Where the list of a camera's card is kept across restarts
+fn list_file(app: &App, name: &str) -> Option<PathBuf> {
+    thumbs_dir(app, name).map(|d| d.join("list.json"))
+}
+
+fn save_list(app: &App, name: &str, list: &CardList) {
+    let Some(path) = list_file(app, name) else {
+        return;
+    };
+    let recordings: Vec<Value> = list
+        .recordings
+        .iter()
+        .map(|v| {
+            json!({"start": v.start, "end": v.end, "kinds": v.kinds, "name": v.name,
+                   "id": v.id, "size": v.size, "sub_id": v.sub_id})
+        })
+        .collect();
+    let text = json!({"updated": list.updated, "recordings": recordings}).to_string();
+    if let Some(dir) = path.parent() {
+        let _ = std::fs::create_dir_all(dir);
+    }
+    if let Err(e) = std::fs::write(&path, text) {
+        log::warn!("{name}: cannot keep the SD card list: {e}");
+    }
+}
+
+fn load_list(app: &App, name: &str) -> Option<CardList> {
+    let text = std::fs::read_to_string(list_file(app, name)?).ok()?;
+    let value: Value = serde_json::from_str(&text).ok()?;
+    let recordings = value
+        .get("recordings")?
+        .as_array()?
+        .iter()
+        .filter_map(|r| {
+            Some(SdRecording {
+                start: serde_json::from_value(r.get("start")?.clone()).ok()?,
+                end: serde_json::from_value(r.get("end")?.clone()).ok()?,
+                kinds: r.get("kinds")?.as_str()?.to_string(),
+                name: r.get("name")?.as_str()?.to_string(),
+                id: r.get("id").and_then(Value::as_str).map(String::from),
+                size: r.get("size").and_then(Value::as_u64),
+                sub_id: r.get("sub_id").and_then(Value::as_str).map(String::from),
+            })
+        })
+        .collect();
+    Some(CardList {
+        updated: value.get("updated").and_then(Value::as_u64),
+        recordings,
+        error: None,
+    })
+}
+
+/// The list of a camera's card: in memory, or else as kept on disk
+fn list_of(app: &App, name: &str) -> CardList {
+    let Ok(mut lists) = app.sd.lists.lock() else {
+        return CardList::default();
+    };
+    if !lists.contains_key(name) {
+        if let Some(list) = load_list(app, name) {
+            lists.insert(name.to_string(), list);
+        }
+    }
+    lists.get(name).cloned().unwrap_or_default()
+}
+
+fn claim(set: &Mutex<HashSet<String>>, name: &str) -> bool {
+    set.lock()
+        .map(|mut s| s.insert(name.to_string()))
+        .unwrap_or(false)
+}
+
+fn release(set: &Mutex<HashSet<String>>, name: &str) {
+    if let Ok(mut s) = set.lock() {
+        s.remove(name);
+    }
+}
+
+fn holds(set: &Mutex<HashSet<String>>, name: &str) -> bool {
+    set.lock().map(|s| s.contains(name)).unwrap_or(false)
+}
+
+/// The list's name of a recording: `YYYY-MM-DD/HHMMSS-HHMMSS.mp4`
+fn file_of(video: &SdRecording) -> String {
+    sdcard::relative_path(video).to_string_lossy().to_string()
+}
+
+fn iso(t: &neolink_core::bc::xml::SdTime) -> String {
+    format!(
+        "{:04}-{:02}-{:02}T{:02}:{:02}:{:02}",
+        t.year, t.month, t.day, t.hour, t.minute, t.second
+    )
+}
+
+/// Where the thumbnails of a camera are kept (beside the snapshots); none without `snapshot_dir`
+fn thumbs_dir(app: &App, name: &str) -> Option<PathBuf> {
+    app.snapshot_dir
+        .as_ref()
+        .map(|d| d.join("sd").join(sanitize(name)))
+}
+
+fn sanitize(name: &str) -> String {
+    name.chars()
+        .map(|c| if c.is_ascii_alphanumeric() || c == '_' { c } else { '_' })
+        .collect()
+}
+
+fn pending(app: &App, name: &str) -> Vec<String> {
+    app.sd
+        .queues
+        .lock()
+        .map(|q| q.get(name).map(|q| q.iter().map(file_of).collect()).unwrap_or_default())
+        .unwrap_or_default()
+}
+
+/// The list as the client sees it
+fn listing(app: &App, name: &str) -> Value {
+    let list = list_of(app, name);
+    let dir = crate::record::camera_dir(name);
+    let thumbs = thumbs_dir(app, name);
+    let queued = pending(app, name);
+    let recordings: Vec<Value> = list
+        .recordings
+        .iter()
+        .map(|v| {
+            let file = file_of(v);
+            json!({
+                "file": file,
+                "start": iso(&v.start),
+                "end": iso(&v.end),
+                "kinds": v.kinds,
+                "size": v.size,
+                "local": dir.as_ref().is_some_and(|d| d.join(&file).exists()),
+                "downloading": queued.contains(&file),
+                "thumbnail": thumbs.as_ref().is_some_and(|t| sdcard::thumbnail_path(t, v).exists()),
+            })
+        })
+        .collect();
+    json!({
+        "updated": list.updated,
+        "refreshing": holds(&app.sd.refreshing, name),
+        "error": list.error,
+        "recordings": recordings,
+    })
+}
+
+/// `sd_recordings`
+pub(super) async fn recordings(
+    app: &App,
+    name: &str,
+    camera: &NeoInstance,
+    args: &Value,
+) -> AnyResult<Value> {
+    if let Some(files) = args.get("thumbnails").and_then(Value::as_array) {
+        let files: Vec<String> = files.iter().filter_map(Value::as_str).map(String::from).collect();
+        if let Ok(mut wanted) = app.sd.wanted_covers.lock() {
+            let list = wanted.entry(name.to_string()).or_default();
+            for file in files {
+                if !list.contains(&file) {
+                    list.push(file);
+                }
+            }
+        }
+        thumbnails(app.clone(), name.to_string(), camera.clone());
+    }
+    if args.get("refresh").and_then(Value::as_bool).unwrap_or(false) {
+        let range = match args.get("hours").and_then(Value::as_u64) {
+            Some(hours) => sdcard::last_hours(hours.clamp(1, 24 * 3650)),
+            None => sdcard::last_hours(
+                args.get("days")
+                    .and_then(Value::as_u64)
+                    .unwrap_or(LIST_DAYS)
+                    .clamp(1, 3650)
+                    * 24,
+            ),
+        };
+        let wait = args.get("wait").and_then(Value::as_bool).unwrap_or(false);
+        if claim(&app.sd.refreshing, name) {
+            let job = refresh(app.clone(), name.to_string(), camera.clone(), range);
+            if wait {
+                job.await;
+            } else {
+                tokio::spawn(job);
+            }
+        }
+    }
+    Ok(listing(app, name))
+}
+
+async fn refresh(
+    app: App,
+    name: String,
+    camera: NeoInstance,
+    range: (neolink_core::bc::xml::SdTime, neolink_core::bc::xml::SdTime),
+) {
+    let found = sdcard::recordings(&name, &camera, range, app.sd_stream).await;
+    if let Ok(mut lists) = app.sd.lists.lock() {
+        let list = lists.entry(name.clone()).or_default();
+        match found {
+            Ok(found) => {
+                log::info!("{name}: {} recordings on the SD card", found.len());
+                *list = CardList {
+                    updated: Some(now()),
+                    recordings: found,
+                    error: None,
+                };
+                save_list(&app, &name, list);
+            }
+            Err(e) => {
+                log::warn!("{name}: cannot search the SD card: {e:#}");
+                list.error = Some(format!("{e:#}"));
+            }
+        }
+    }
+    release(&app.sd.refreshing, &name);
+    thumbnails(app, name, camera);
+}
+
+/// Fetch the covers the list lacks, newest first, in the background
+fn thumbnails(app: App, name: String, camera: NeoInstance) {
+    let Some(thumbs) = thumbs_dir(&app, &name) else {
+        return;
+    };
+    if !claim(&app.sd.thumbnailing, &name) {
+        return;
+    }
+    tokio::spawn(async move {
+        let mut failures = 0;
+        let mut done: HashSet<String> = HashSet::new();
+        while let Some(video) = next_cover(&app, &name, &thumbs, &done) {
+            done.insert(file_of(&video));
+            match sdcard::fetch_thumbnail(&name, &camera, &thumbs, &video).await {
+                Ok(_) => failures = 0,
+                Err(e) => {
+                    log::info!("{name}: no cover for {}: {e:#}", file_of(&video));
+                    failures += 1;
+                    if failures >= COVER_FAILURES {
+                        break;
+                    }
+                }
+            }
+        }
+        release(&app.sd.thumbnailing, &name);
+    });
+}
+
+/// The next cover to fetch: one a client asked for, else one of the newest; none tried already
+fn next_cover(
+    app: &App,
+    name: &str,
+    thumbs: &std::path::Path,
+    done: &HashSet<String>,
+) -> Option<SdRecording> {
+    let list = list_of(app, name).recordings;
+    let lacking = |v: &&SdRecording| {
+        !done.contains(&file_of(v)) && !sdcard::thumbnail_path(thumbs, v).exists()
+    };
+    let asked = app
+        .sd
+        .wanted_covers
+        .lock()
+        .ok()
+        .map(|mut w| std::mem::take(w.entry(name.to_string()).or_default()))
+        .unwrap_or_default();
+    let found = asked
+        .iter()
+        .filter_map(|file| list.iter().find(|v| &file_of(v) == file))
+        .find(lacking)
+        .cloned();
+    // Keep the rest of what was asked for the next round
+    if let Some(found) = &found {
+        let rest: Vec<String> = asked.into_iter().filter(|f| *f != file_of(found)).collect();
+        if let Ok(mut w) = app.sd.wanted_covers.lock() {
+            w.entry(name.to_string()).or_default().extend(rest);
+        }
+        return Some(found.clone());
+    }
+    list.iter().rev().take(NEWEST_COVERS).find(lacking).cloned()
+}
+
+/// The switch of the automatic copy: a file beside the camera's thumbnails
+fn auto_file(app: &App, name: &str) -> Option<PathBuf> {
+    crate::record::camera_dir(name)?;
+    thumbs_dir(app, name).map(|d| d.join("auto"))
+}
+
+/// Whether the newest recording is copied after each motion; None without a recording folder
+pub(super) fn auto_enabled(app: &App, name: &str) -> Option<bool> {
+    auto_file(app, name).map(|f| f.exists())
+}
+
+/// `sd_auto`
+pub(super) async fn set_auto(app: &App, name: &str, on: bool) -> AnyResult<()> {
+    let file = auto_file(app, name)
+        .ok_or_else(|| anyhow!("no recording folder (record_dir) or snapshot_dir is set"))?;
+    if on {
+        if let Some(dir) = file.parent() {
+            std::fs::create_dir_all(dir)?;
+        }
+        std::fs::write(&file, b"on")?;
+    } else if file.exists() {
+        std::fs::remove_file(&file)?;
+    }
+    update(app, name, |s| s.sd_auto = Some(on)).await;
+    Ok(())
+}
+
+/// A motion notification came: with `sd_auto` on, copy the newest recording a while later (once
+/// for a burst of notifications)
+pub(super) fn after_motion(app: &App, name: &str, camera: &NeoInstance) {
+    if auto_enabled(app, name) != Some(true) || !claim(&app.sd.auto_waiting, name) {
+        return;
+    }
+    let (app, name, camera) = (app.clone(), name.to_string(), camera.clone());
+    tokio::spawn(async move {
+        tokio::time::sleep(SD_AUTO_DELAY).await;
+        release(&app.sd.auto_waiting, &name);
+        if auto_enabled(&app, &name) != Some(true) {
+            return;
+        }
+        log::info!("{name}: copying the newest SD card recording after motion");
+        if let Err(e) = sync(&app, &name, &camera, &json!({"hours": 1, "latest": true})).await {
+            log::warn!("{name}: automatic copy failed: {e:#}");
+        }
+    });
+}
+
+/// `sd_sync`
+pub(super) async fn sync(
+    app: &App,
+    name: &str,
+    camera: &NeoInstance,
+    args: &Value,
+) -> AnyResult<Value> {
+    let dir = crate::record::camera_dir(name)
+        .ok_or_else(|| anyhow!("no recording folder (record_dir) is set"))?;
+    let chosen: Vec<SdRecording> = match args.get("files").and_then(Value::as_array) {
+        Some(files) => {
+            let files: Vec<&str> = files.iter().filter_map(Value::as_str).collect();
+            let list = list_of(app, name).recordings;
+            let found: Vec<SdRecording> = list
+                .into_iter()
+                .filter(|v| files.contains(&file_of(v).as_str()))
+                .collect();
+            if found.len() < files.len() {
+                return Err(anyhow!(
+                    "some files are not in the list of the SD card; refresh it first"
+                ));
+            }
+            found
+        }
+        None => {
+            let hours = args
+                .get("hours")
+                .and_then(Value::as_u64)
+                .unwrap_or(24)
+                .clamp(1, 24 * 31);
+            let found =
+                sdcard::recordings(name, camera, sdcard::last_hours(hours), app.sd_stream).await?;
+            if args.get("latest").and_then(Value::as_bool).unwrap_or(false) {
+                found.last().cloned().into_iter().collect()
+            } else {
+                found
+            }
+        }
+    };
+    let todo = sdcard::missing(&dir, &chosen);
+    let queued = enqueue(app, name, todo);
+    log::info!("{name}: {queued} SD card recordings to copy");
+    start_worker(app.clone(), name.to_string(), camera.clone(), dir);
+    Ok(json!({"queued": queued, "pending": pending(app, name)}))
+}
+
+/// Add to the queue what is not in it yet; returns how many were added
+fn enqueue(app: &App, name: &str, todo: Vec<SdRecording>) -> usize {
+    let Ok(mut queues) = app.sd.queues.lock() else {
+        return 0;
+    };
+    let queue = queues.entry(name.to_string()).or_default();
+    let mut added = 0;
+    for video in todo {
+        if !queue.iter().any(|q| file_of(q) == file_of(&video)) {
+            queue.push_back(video);
+            added += 1;
+        }
+    }
+    added
+}
+
+fn next_in_queue(app: &App, name: &str) -> Option<SdRecording> {
+    app.sd
+        .queues
+        .lock()
+        .ok()
+        .and_then(|q| q.get(name).and_then(|q| q.front().cloned()))
+}
+
+fn done_with(app: &App, name: &str, video: &SdRecording) {
+    if let Ok(mut queues) = app.sd.queues.lock() {
+        if let Some(queue) = queues.get_mut(name) {
+            queue.retain(|q| file_of(q) != file_of(video));
+        }
+    }
+}
+
+/// Copy the queue of `name` one by one, unless a worker for it runs already
+fn start_worker(app: App, name: String, camera: NeoInstance, dir: PathBuf) {
+    if next_in_queue(&app, &name).is_none() || !sdcard::claim(&name) {
+        return;
+    }
+    tokio::spawn(async move {
+        sdcard::remove_parts(&dir);
+        let files = pending(&app, &name);
+        update(&app, &name, |s| {
+            s.sd_sync = Some(SdSyncState {
+                running: true,
+                total: files.len() as u32,
+                pending: files,
+                ..Default::default()
+            })
+        })
+        .await;
+        while let Some(video) = next_in_queue(&app, &name) {
+            let result = sdcard::copy(&name, &camera, &dir, &video, app.sd_stream).await;
+            done_with(&app, &name, &video);
+            let left = pending(&app, &name);
+            update(&app, &name, |s| {
+                let sync = s.sd_sync.get_or_insert_with(Default::default);
+                match &result {
+                    Ok(_) => {
+                        sync.done += 1;
+                        sync.last_file = Some(file_of(&video));
+                    }
+                    Err(e) => {
+                        sync.failed += 1;
+                        sync.error = Some(format!("{e:#}"));
+                    }
+                }
+                // Asked for while copying
+                sync.total = sync.done + sync.failed + left.len() as u32;
+                sync.pending = left;
+            })
+            .await;
+            match result {
+                Ok(path) => log::info!("{name}: copied {}", path.display()),
+                Err(e) => log::warn!("{name}: cannot copy a recording: {e:#}"),
+            }
+        }
+        sdcard::release(&name);
+        update(&app, &name, |s| {
+            let sync = s.sd_sync.get_or_insert_with(Default::default);
+            sync.running = false;
+            sync.finished = Some(now());
+        })
+        .await;
+        log::info!("{name}: SD card copies done");
+        // Asked for just as the worker stopped
+        if next_in_queue(&app, &name).is_some() {
+            start_worker(app, name, camera, dir);
+        }
+    });
+}
+
+/// `GET /sd_thumbnail/{camera}/{YYYY-MM-DD}/{HHMMSS-HHMMSS}.jpg`
+pub(super) async fn thumbnail(
+    State(app): State<App>,
+    Path((name, day, file)): Path<(String, String, String)>,
+    headers: HeaderMap,
+    Query(query): Query<AuthQuery>,
+) -> Response {
+    if !authorized(&app, &headers, &query) {
+        return StatusCode::UNAUTHORIZED.into_response();
+    }
+    let valid = |s: &str, extra: &[char]| {
+        !s.is_empty() && s.chars().all(|c| c.is_ascii_digit() || extra.contains(&c))
+    };
+    if !valid(&day, &['-']) || !file.ends_with(".jpg") || !valid(&file[..file.len() - 4], &['-'])
+    {
+        return StatusCode::BAD_REQUEST.into_response();
+    }
+    let Some(dir) = thumbs_dir(&app, &name) else {
+        return StatusCode::NOT_FOUND.into_response();
+    };
+    match tokio::fs::read(dir.join(&day).join(&file)).await {
+        Ok(jpeg) => ([(header::CONTENT_TYPE, "image/jpeg")], jpeg).into_response(),
+        Err(_) => (StatusCode::NOT_FOUND, "no thumbnail").into_response(),
+    }
+}
+
