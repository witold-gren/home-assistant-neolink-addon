+/// Reads `<dir>/<camera>.jpg` files saved by earlier runs; the file time is the snapshot time
+fn load_snapshots(dir: Option<&str>) -> HashMap<String, (u64, Vec<u8>)> {
+    let mut snapshots = HashMap::new();
+    let Some(dir) = dir else {
+        return snapshots;
+    };
+    if let Err(e) = std::fs::create_dir_all(dir) {
+        log::warn!("Cannot create snapshot directory {dir}: {e}");
+        return snapshots;
+    }
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return snapshots;
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if path.extension().and_then(|e| e.to_str()) != Some("jpg") {
+            continue;
+        }
+        let (Some(name), Ok(jpeg)) = (
+            path.file_stem().and_then(|n| n.to_str()),
+            std::fs::read(&path),
+        ) else {
+            continue;
+        };
+        let taken = entry
+            .metadata()
+            .and_then(|m| m.modified())
+            .ok()
+            .and_then(|t| t.duration_since(UNIX_EPOCH).ok())
+            .map(|d| d.as_secs())
+            .unwrap_or_default();
+        snapshots.insert(name.to_string(), (taken, jpeg));
+    }
+    snapshots
+}
+
+/// While connected, refreshes the cached snapshot whenever it is older than `every`
+async fn refresh_snapshots(app: &App, name: &str, every: Duration) {
+    // Let the camera finish waking up (stream start, state reads) first
+    sleep(Duration::from_secs(5)).await;
+    loop {
+        let age = app
+            .snapshots
+            .read()
+            .await
+            .get(name)
+            .map(|(taken, _)| now().saturating_sub(*taken));
+        if age.map(|a| a >= every.as_secs()).unwrap_or(true) {
+            if let Err(e) = take_snapshot(app, name, false).await {
+                log::debug!("{name}: passive snapshot failed: {e:#}");
+            }
+        }
+        sleep(every).await;
+    }
+}
