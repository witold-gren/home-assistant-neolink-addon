 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+
+    #[test]
+    fn a_reolink_block_plays_64_ms() {
+        // 16 kHz, lengthPerEncoder 1024: 512 bytes of samples + 4 of header = 1025 samples
+        let length = block_duration(516, 16000);
+        assert!((length.as_secs_f64() - 1025.0 / 16000.0).abs() < 1e-9);
+    }
+
+    #[test]
+    fn sending_waits_only_when_far_ahead_of_the_camera() {
+        let now = tokio::time::Instant::now();
+        let lead = Duration::from_millis(300);
+        // Nothing playing, or behind: send at once
+        assert_eq!(send_delay(now, now, lead), None);
+        assert_eq!(send_delay(now - Duration::from_secs(1), now, lead), None);
+        // Within the lead: send at once
+        assert_eq!(
+            send_delay(now + Duration::from_millis(250), now, lead),
+            None
+        );
+        // Beyond the lead: wait for the excess only
+        assert_eq!(
+            send_delay(now + Duration::from_millis(500), now, lead),
+            Some(Duration::from_millis(200))
+        );
+    }
+}
