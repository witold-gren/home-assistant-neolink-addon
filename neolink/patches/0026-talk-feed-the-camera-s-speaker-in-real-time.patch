+impl BcCamera {
+    /// Talk live: ADPCM blocks (block size + 4 bytes of predictor state, as the TalkConfig says)
+    /// are sent to the camera as they come, a block per message.
+    ///
+    /// `talk_stream` waits for the camera's answer to each message before the next one, which over
+    /// a 4G relay (a round trip longer than the 64 ms a block plays) sends slower than real time:
+    /// the talker's queue fills, the sound lags further and further and is cut where the queue
+    /// overflows. Here the answers are read beside the sending, and the sending is only held back
+    /// when it is more than `TALK_LEAD` ahead of what the camera has played.
+    pub async fn talk_live(
+        &self,
+        mut rx: tokio::sync::mpsc::Receiver<Vec<u8>>,
+        talk_config: TalkConfig,
+    ) -> Result<()> {
+        let connection = self.get_connection();
+        let (_block_size, sample_rate) = self.talk_begin(talk_config).await?;
+        let msg_num = self.new_message_num();
+        let mut sub = connection.subscribe(MSG_ID_TALK, msg_num).await?;
+
+        // When the sound sent so far ends playing on the camera
+        let mut played_until = tokio::time::Instant::now();
+        loop {
+            tokio::select! {
+                block = rx.recv() => {
+                    let Some(block) = block else { break };
+                    if block.len() <= 4 {
+                        continue;
+                    }
+                    let now = tokio::time::Instant::now();
+                    if let Some(wait) = send_delay(played_until, now, TALK_LEAD) {
+                        tokio::time::sleep(wait).await;
+                    }
+                    let length = block_duration(block.len(), sample_rate.into());
+                    let payload = BcMedia::Adpcm(BcMediaAdpcm { data: block }).serialize(vec![])?;
+                    let msg = Bc {
+                        meta: BcMeta {
+                            msg_id: MSG_ID_TALK,
+                            channel_id: self.channel_id,
+                            msg_num,
+                            stream_type: 0,
+                            response_code: 0,
+                            class: 0x6414,
+                        },
+                        body: BcBody::ModernMsg(ModernMsg {
+                            extension: Some(Extension {
+                                channel_id: Some(self.channel_id),
+                                binary_data: Some(1),
+                                ..Default::default()
+                            }),
+                            payload: Some(BcPayloads::Binary(payload)),
+                        }),
+                    };
+                    sub.send(msg).await?;
+                    played_until = std::cmp::max(played_until, tokio::time::Instant::now()) + length;
+                }
+                // The camera's answers: read so that they do not pile up
+                answer = sub.recv() => {
+                    answer?;
+                }
+            }
+        }
+
+        // What was sent is still playing; stopping now would cut it
+        tokio::time::sleep_until(played_until + std::time::Duration::from_millis(100)).await;
+        self.talk_stop().await?;
+        Ok(())
+    }
+}
+
+/// How far ahead of the camera's playing the live talk may send (the camera buffers this much)
+const TALK_LEAD: std::time::Duration = std::time::Duration::from_millis(300);
+
+/// How long an ADPCM block plays: 2 samples a byte after the 4-byte header, which holds 1 sample
+fn block_duration(block_len: usize, sample_rate: u32) -> std::time::Duration {
+    let samples = block_len.saturating_sub(4) * 2 + 1;
+    std::time::Duration::from_secs_f64(samples as f64 / sample_rate.max(1) as f64)
+}
+
+/// How long to wait before the next block, so that what was sent stays at most `lead` ahead
+fn send_delay(
+    played_until: tokio::time::Instant,
+    now: tokio::time::Instant,
+    lead: std::time::Duration,
+) -> Option<std::time::Duration> {
+    let ahead = played_until.checked_duration_since(now)?;
+    ahead.checked_sub(lead).filter(|wait| !wait.is_zero())
+}
+
 struct BufferedStream {
     rx: Receiver<Vec<u8>>,
     buffer: Vec<u8>,
@@ -480,3 +576,35 @@ impl BufRead for BufferedStream {
         self.consumed += amt;
