+                        // Right after a camera has gone to sleep the server can keep answering
+                        // a registration with "wait" (R2C_T) for its whole 15 s, while a fresh
+                        // registration is answered in about 3 s: a second one, with a client id
+                        // of its own, starts after REGISTER_STAGGER and the first answer wins.
+                        let answered = {
+                            let first = async {
+                                let result = discovery.get_registration(uid).await?;
+                                Result::Ok((None, result))
+                            };
+                            let second = async {
