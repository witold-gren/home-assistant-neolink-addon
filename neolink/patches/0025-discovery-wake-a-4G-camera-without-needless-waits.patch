diff --git a/crates/core/src/bc_protocol/connection/discovery.rs b/crates/core/src/bc_protocol/connection/discovery.rs
index 7fb70fc..b58cc24 100644
--- a/crates/core/src/bc_protocol/connection/discovery.rs
+++ b/crates/core/src/bc_protocol/connection/discovery.rs
@@ -322,22 +322,35 @@ impl Discoverer {
         result
     }
 
+    /// Send a message five times, 500 ms apart, without waiting for the repeats: the first copy
+    /// goes out now and the rest in the background. Waiting for all five held every connection
+    /// back by 2 s between the camera's confirmation and the login.
     async fn send_and_forget(&self, mut disc: UdpDiscovery, dest: SocketAddr) -> Result<()> {
         if disc.tid == 0 {
             // If 0 make a random one
             let target_tid = generate_tid();
             disc.tid = target_tid;
         }
-        let mut inter = interval(*RESEND_WAIT);
-        inter.set_missed_tick_behavior(MissedTickBehavior::Skip);
         let msg = BcUdp::Discovery(disc);
+        self.send(msg.clone(), dest).await?;
 
-        for _i in 0..5 {
-            inter.tick().await;
-
-            self.send(msg.clone(), dest).await?;
-        }
-
+        let writer = self.writer.clone();
+        let cancel = self.cancel.clone();
+        self.handle.write().await.spawn(async move {
+            let mut inter = interval(*RESEND_WAIT);
+            inter.set_missed_tick_behavior(MissedTickBehavior::Skip);
+            inter.tick().await; // The first tick is now: that copy was sent above
+            for _i in 1..5 {
+                tokio::select! {
+                    _ = cancel.cancelled() => break,
+                    _ = inter.tick() => {}
+                }
+                if writer.send(Ok((msg.clone(), dest))).await.is_err() {
+                    break;
+                }
+            }
+            Result::Ok(())
+        });
         Ok(())
     }
 
@@ -1561,3 +1574,37 @@ async fn connect() -> Result<UdpSocket> {
     ```
 
