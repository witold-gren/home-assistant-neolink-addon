+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn a_confirmation_is_repeated_without_holding_the_connection_back() {
+        let discoverer = Discoverer::new().await.unwrap();
+        let receiver = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let dest = receiver.local_addr().unwrap();
+        let msg = UdpDiscovery {
+            tid: 0,
+            payload: UdpXml::C2rCfm(C2rCfm {
+                sid: 1,
+                cid: 2,
+                did: 3,
+                rsp: 0,
+                conn: "relay".to_string(),
+            }),
+        };
+
+        let started = tokio::time::Instant::now();
+        discoverer.send_and_forget(msg, dest).await.unwrap();
+        // The first copy is sent, the four repeats (500 ms apart) do not hold the caller
+        assert!(started.elapsed() < Duration::from_millis(300));
+
+        let mut copies = 0;
+        let mut buf = [0u8; 2048];
+        while let Ok(Ok(_)) = timeout(Duration::from_secs(1), receiver.recv_from(&mut buf)).await {
+            copies += 1;
+        }
+        assert_eq!(copies, 5);
+    }
+}
