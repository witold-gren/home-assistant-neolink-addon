+/// `GET /talk/{camera}?rate=<Hz>`: a WebSocket of PCM s16le mono played on the camera's speaker
+#[cfg(feature = "gstreamer")]
+async fn talk_handler(
+    State(app): State<App>,
+    Path(name): Path<String>,
+    headers: HeaderMap,
+    Query(query): Query<AuthQuery>,
+    upgrade: WebSocketUpgrade,
+) -> Response {
+    if !authorized(&app, &headers, &query) {
+        return StatusCode::UNAUTHORIZED.into_response();
+    }
+    let Some(rate) = talk::talk_rate(query.rate) else {
+        return (StatusCode::BAD_REQUEST, "rate must be 8000-48000 Hz").into_response();
+    };
+    if !app.states.read().await.contains_key(&name) {
+        return StatusCode::NOT_FOUND.into_response();
+    }
+    let camera = match app.reactor.get(&name).await {
+        Ok(camera) => camera,
+        Err(_) => return StatusCode::NOT_FOUND.into_response(),
+    };
+    upgrade.on_upgrade(move |socket| talk::serve(socket, camera, name, rate))
+}
