+/// How long a live view waits for the camera's next frame. A camera that stops sending (a
+/// stalled relay, a camera falling asleep) left the stream waiting forever, and the waiting
+/// stream kept the camera's session open: a battery camera stayed awake for hours.
+const MEDIA_IDLE_LIMIT: Duration = Duration::from_secs(20);
+
+/// The camera's next frame, or None when the camera has ended the stream or sent nothing for
+/// `limit`
+fn next_media(
+    runtime: &tokio::runtime::Handle,
+    media_rx: &mut tokio::sync::mpsc::Receiver<BcMedia>,
+    limit: Option<Duration>,
+) -> Option<BcMedia> {
+    let Some(limit) = limit else {
+        return media_rx.blocking_recv();
+    };
+    match runtime.block_on(async { tokio::time::timeout(limit, media_rx.recv()).await }) {
+        Ok(media) => media,
+        Err(_) => {
+            log::info!("No frame from the camera for {limit:?}, ending the live view");
+            None
+        }
+    }
+}
+
 /// How long an appsrc may refuse buffers as flushing before the stream is dropped. A client
 /// that left without a TEARDOWN leaves its pipeline flushing forever, and a stream that keeps
 /// running for nobody holds the camera awake (and drains a battery camera).
@@ -1056,6 +1092,24 @@ mod tests {
         sink
     }
 
+    #[test]
+    fn a_silent_camera_ends_the_live_view() {
+        let runtime = tokio::runtime::Runtime::new().unwrap();
+        let (tx, mut rx) = tokio::sync::mpsc::channel(4);
+        runtime
+            .block_on(tx.send(BcMedia::Aac(neolink_core::bcmedia::model::BcMediaAac {
+                data: vec![0xff],
+            })))
+            .unwrap();
+        let limit = Duration::from_millis(200);
+        assert!(next_media(runtime.handle(), &mut rx, Some(limit)).is_some());
+        // The sender is still there (the camera is connected) but sends nothing
+        let waited = Instant::now();
+        assert!(next_media(runtime.handle(), &mut rx, Some(limit)).is_none());
+        assert!(waited.elapsed() >= limit);
+        drop(tx);
+    }
+
