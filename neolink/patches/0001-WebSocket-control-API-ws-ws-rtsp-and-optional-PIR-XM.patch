+//! WebSocket control API
+//!
+//! A JSON API for frontends such as a Home Assistant integration, without an MQTT broker:
+//!
+//! - `GET /ws` – WebSocket: a `hello` with every camera's state on connect, then
+//!   request/response commands (`{"id": 1, "command": "led", "camera": "G330", "args": {"on": true}}`)
+//!   and pushed `state` events whenever a camera's state changes
+//! - `GET /snapshot/{camera}` – a JPEG still (`?max_age=<s>` serves a cached one if fresh enough)
+//! - `GET /healthz` – liveness and which cameras are connected
+//!
+//! Battery cameras: background reads use passive tasks, so they never wake a camera that
+//! disconnected for inactivity (`idle_disconnect`). Only explicit commands and snapshots do.
+//!
+//! Optional authentication: `token` in `[websocket]`, sent as `Authorization: Bearer <token>`
+//! or `?token=<token>`.
+use crate::{
+    common::{MdState, NeoInstance, NeoReactor},
+    config::{Config, WebsocketConfig},
+    AnyResult,
+};
+use anyhow::{anyhow, Context, Result};
+use axum::{
+    extract::{
+        ws::{Message, WebSocket, WebSocketUpgrade},
+        Path, Query, State,
+    },
+    http::{header, HeaderMap, StatusCode},
+    response::{IntoResponse, Response},
+    routing::get,
+    Json, Router,
+};
+use base64::{engine::general_purpose::STANDARD as BASE64, Engine as _};
+use neolink_core::bc_protocol::{BcCamera, LightState};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::{
+    collections::{HashMap, HashSet},
+    future::Future,
+    pin::Pin,
+    sync::Arc,
+    time::{SystemTime, UNIX_EPOCH},
+};
+use tokio::{
+    sync::{broadcast, mpsc, watch::Receiver as WatchReceiver, RwLock},
+    task::JoinSet,
+    time::{interval, sleep, timeout, Duration, MissedTickBehavior},
+};
+use tokio_util::sync::CancellationToken;
+
+mod cmdline;
+
+pub(crate) use cmdline::Opt;
+
+/// Longest wait for a camera that has to be woken up over a relay (4G) connection
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(90);
+
+#[derive(Debug, Clone, Default, Serialize)]
+struct BatteryState {
+    percent: u32,
+    charge_status: String,
+    adapter_status: String,
+    voltage: i32,
+    current: i32,
+    temperature: i32,
+    low_power: bool,
+}
+
+#[derive(Debug, Clone, Default, Serialize)]
+struct CameraState {
+    name: String,
+    uid: Option<String>,
+    connected: bool,
+    model: Option<String>,
+    firmware: Option<String>,
+    hardware: Option<String>,
+    serial: Option<String>,
+    battery: Option<BatteryState>,
+    led: Option<bool>,
+    ir: Option<String>,
+    pir: Option<bool>,
+    motion: Option<bool>,
+    motion_enabled: bool,
+    /// Unix time (s) of the last change
+    updated: u64,
+}
+
+struct Shared {
+    reactor: NeoReactor,
+    token: Option<String>,
+    states: RwLock<HashMap<String, CameraState>>,
+    snapshots: RwLock<HashMap<String, (u64, Vec<u8>)>>,
+    events: broadcast::Sender<String>,
+}
+
+type App = Arc<Shared>;
+
+type CameraTask<'a, T> = Pin<Box<dyn Future<Output = AnyResult<T>> + Send + 'a>>;
+
+fn now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or_default()
+}
+
+pub(crate) async fn main(_: Opt, reactor: NeoReactor) -> Result<()> {
+    let config = reactor.config().await?;
+    let ws_config = config.borrow().websocket.clone().unwrap_or_default();
+    let (events, _) = broadcast::channel(256);
+    let app: App = Arc::new(Shared {
+        reactor,
+        token: ws_config.token.clone().filter(|t| !t.is_empty()),
+        states: Default::default(),
+        snapshots: Default::default(),
+        events,
+    });
+
+    let cancel = CancellationToken::new();
+    let _cancel_drop = cancel.clone().drop_guard();
+    let mut set = JoinSet::<AnyResult<()>>::new();
+    set.spawn(watch_cameras(
+        app.clone(),
+        config.clone(),
+        ws_config.clone(),
+        cancel.clone(),
+    ));
+
+    let router = Router::new()
+        .route("/healthz", get(healthz))
+        .route("/ws", get(ws_handler))
+        .route("/snapshot/:name", get(snapshot))
+        .with_state(app.clone());
+    let addr = format!("{}:{}", ws_config.bind, ws_config.port);
+    let listener = tokio::net::TcpListener::bind(&addr)
+        .await
+        .with_context(|| format!("Failed to bind the WebSocket API to {addr}"))?;
+    log::info!("WebSocket API listening on {addr} (/ws, /snapshot/<camera>, /healthz)");
+    set.spawn(async move {
+        axum::serve(listener, router)
+            .await
+            .with_context(|| "WebSocket API server stopped")
+    });
+
+    while let Some(result) = set.join_next().await {
+        result??;
+    }
+    Ok(())
+}
+
+/// Updates a camera's state and pushes it to every client
+async fn update<F: FnOnce(&mut CameraState)>(app: &App, name: &str, change: F) {
+    let state = {
+        let mut states = app.states.write().await;
+        let state = states
+            .entry(name.to_string())
+            .or_insert_with(|| CameraState {
+                name: name.to_string(),
+                ..Default::default()
+            });
+        change(state);
+        state.updated = now();
+        state.clone()
+    };
+    let _ = app.events.send(
+        json!({"type": "event", "event": "state", "camera": name, "state": state}).to_string(),
+    );
+}
+
+async fn cameras(app: &App) -> Vec<CameraState> {
+    let mut list: Vec<CameraState> = app.states.read().await.values().cloned().collect();
+    list.sort_by(|a, b| a.name.cmp(&b.name));
+    list
+}
+
+/// Starts and stops per-camera watchers as cameras come and go in the config
+async fn watch_cameras(
+    app: App,
+    mut config: WatchReceiver<Config>,
+    ws: WebsocketConfig,
+    cancel: CancellationToken,
+) -> AnyResult<()> {
+    let mut running: HashMap<String, CancellationToken> = HashMap::new();
+    loop {
+        let cams: Vec<(String, Option<String>)> = config
+            .borrow()
+            .cameras
+            .iter()
+            .filter(|c| c.enabled)
+            .map(|c| (c.name.clone(), c.camera_uid.clone()))
+            .collect();
+        let names: HashSet<String> = cams.iter().map(|(name, _)| name.clone()).collect();
+        for (name, uid) in cams {
+            if running.contains_key(&name) {
+                continue;
+            }
+            update(&app, &name, |s| {
+                s.uid = uid.clone();
+                s.motion_enabled = ws.enable_motion;
+            })
+            .await;
+            let token = cancel.child_token();
+            running.insert(name.clone(), token.clone());
+            let app = app.clone();
+            let ws = ws.clone();
+            tokio::spawn(async move {
+                loop {
+                    let result = tokio::select! {
+                        _ = token.cancelled() => break,
+                        v = watch_camera(app.clone(), &name, &ws) => v,
+                    };
+                    if let Err(e) = result {
+                        log::warn!("{name}: WebSocket watcher restarting: {e:#}");
+                    }
+                    sleep(Duration::from_secs(5)).await;
+                }
+            });
+        }
+        running.retain(|name, token| {
+            let keep = names.contains(name);
+            if !keep {
+                token.cancel();
+            }
+            keep
+        });
+        app.states
+            .write()
+            .await
+            .retain(|name, _| names.contains(name));
+        tokio::select! {
+            _ = cancel.cancelled() => return Ok(()),
+            v = config.changed() => v?,
+        }
+    }
+}
+
+/// Follows one camera: connection, battery while connected, motion
+async fn watch_camera(app: App, name: &str, ws: &WebsocketConfig) -> AnyResult<()> {
+    let camera = app.reactor.get(name).await?;
+    let mut set = JoinSet::<AnyResult<()>>::new();
+
+    if ws.battery_update > 0 {
+        let (app, camera, name) = (app.clone(), camera.clone(), name.to_string());
+        let every = Duration::from_millis(ws.battery_update);
+        set.spawn(async move {
+            let mut tick = interval(every);
+            tick.set_missed_tick_behavior(MissedTickBehavior::Skip);
+            loop {
+                tick.tick().await;
+                // Passive: waits for a connection instead of waking the camera
+                match read(&camera, false, |c| {
+                    Box::pin(async move { AnyResult::Ok(c.battery_info().await?) })
+                })
+                .await
+                {
+                    Ok(b) => update(&app, &name, |s| s.battery = Some(battery_state(&b))).await,
+                    Err(e) => log::debug!("{name}: battery read failed: {e:#}"),
+                }
+            }
+        });
+    }
+
+    if ws.enable_motion {
+        let (app, camera, name) = (app.clone(), camera.clone(), name.to_string());
+        set.spawn(async move {
+            let mut md = camera.motion().await?;
+            loop {
+                md.changed().await?;
+                let motion = match &*md.borrow() {
+                    MdState::Start(_) => Some(true),
+                    MdState::Stop(_) => Some(false),
+                    MdState::Unknown => None,
+                };
+                update(&app, &name, |s| s.motion = motion).await;
+            }
+        });
+    }
+
+    {
+        let (app, camera, name) = (app.clone(), camera.clone(), name.to_string());
+        set.spawn(async move {
+            let mut watch = camera.camera();
+            loop {
+                watch.wait_for(|c| c.upgrade().is_some()).await?;
+                update(&app, &name, |s| s.connected = true).await;
+                // Fill in model, firmware, LED/IR/PIR and battery while the link is up anyway
+                let refresh = refresh(&app, &name, &camera, false);
+                tokio::select! {
+                    _ = refresh => {},
+                    v = watch.wait_for(|c| c.upgrade().is_none()) => { v?; }
+                }
+                watch.wait_for(|c| c.upgrade().is_none()).await?;
+                update(&app, &name, |s| s.connected = false).await;
+            }
+        });
+    }
+
+    while let Some(result) = set.join_next().await {
+        result??;
+    }
+    Ok(())
+}
+
+/// Runs a camera task; `active` wakes and connects the camera, passive waits for a connection
+async fn read<T, F>(camera: &NeoInstance, active: bool, task: F) -> AnyResult<T>
+where
+    F: for<'a> Fn(&'a BcCamera) -> CameraTask<'a, T>,
+{
+    if active {
+        timeout(COMMAND_TIMEOUT, camera.run_task(task))
+            .await
+            .map_err(|_| anyhow!("camera did not answer within {COMMAND_TIMEOUT:?}"))?
+    } else {
+        camera.run_passive_task(task).await
+    }
+}
+
+fn battery_state(b: &neolink_core::bc::xml::BatteryInfo) -> BatteryState {
+    BatteryState {
+        percent: b.battery_percent,
+        charge_status: b.charge_status.clone(),
+        adapter_status: b.adapter_status.clone(),
+        voltage: b.voltage,
+        current: b.current,
+        temperature: b.temperature,
+        low_power: b.low_power != 0,
+    }
+}
+
+/// Reads model/firmware, LED/IR, PIR and battery; errors of unsupported features are ignored
+async fn refresh(app: &App, name: &str, camera: &NeoInstance, active: bool) {
+    match read(camera, active, |c| {
+        Box::pin(async move { AnyResult::Ok(c.version().await?) })
+    })
+    .await
+    {
+        Ok(v) => {
+            update(app, name, |s| {
+                s.model = v.model.clone();
+                s.firmware = Some(v.firmwareVersion.clone());
+                s.hardware = Some(v.hardwareVersion.clone());
+                s.serial = Some(v.serialNumber.clone());
+            })
+            .await
+        }
+        Err(e) => log::debug!("{name}: version read failed: {e:#}"),
+    }
+    match read(camera, active, |c| {
+        Box::pin(async move { AnyResult::Ok(c.get_ledstate().await?) })
+    })
+    .await
+    {
+        Ok(l) => {
+            update(app, name, |s| {
+                s.led = Some(l.light_state == "open");
+                s.ir = Some(
+                    match l.state.as_str() {
+                        "open" => "on",
+                        "close" => "off",
+                        other => other,
+                    }
+                    .to_string(),
+                );
+            })
+            .await
+        }
+        Err(e) => log::debug!("{name}: LED state read failed: {e:#}"),
+    }
+    match read(camera, active, |c| {
+        Box::pin(async move { AnyResult::Ok(c.get_pirstate().await?) })
+    })
+    .await
+    {
+        Ok(p) => update(app, name, |s| s.pir = Some(p.enable != 0)).await,
+        Err(e) => log::debug!("{name}: PIR state read failed: {e:#}"),
+    }
+    match read(camera, active, |c| {
+        Box::pin(async move { AnyResult::Ok(c.battery_info().await?) })
+    })
+    .await
+    {
+        Ok(b) => update(app, name, |s| s.battery = Some(battery_state(&b))).await,
+        Err(e) => log::debug!("{name}: battery read failed: {e:#}"),
+    }
+}
+
+#[derive(Deserialize)]
+struct AuthQuery {
+    token: Option<String>,
+    max_age: Option<u64>,
+}
+
+fn authorized(app: &App, headers: &HeaderMap, query: &AuthQuery) -> bool {
+    let Some(token) = &app.token else {
+        return true;
+    };
+    if query.token.as_deref() == Some(token.as_str()) {
+        return true;
+    }
+    headers
+        .get(header::AUTHORIZATION)
+        .and_then(|v| v.to_str().ok())
+        .map(|v| v == format!("Bearer {token}"))
+        .unwrap_or(false)
+}
+
+async fn healthz(State(app): State<App>) -> Json<Value> {
+    let connected: HashMap<String, bool> = app
+        .states
+        .read()
+        .await
+        .iter()
+        .map(|(name, s)| (name.clone(), s.connected))
+        .collect();
+    Json(json!({"ok": true, "version": env!("NEOLINK_VERSION"), "cameras": connected}))
+}
+
+async fn snapshot(
+    State(app): State<App>,
+    Path(name): Path<String>,
+    headers: HeaderMap,
+    Query(query): Query<AuthQuery>,
+) -> Response {
+    if !authorized(&app, &headers, &query) {
+        return StatusCode::UNAUTHORIZED.into_response();
+    }
+    if !app.states.read().await.contains_key(&name) {
+        return (StatusCode::NOT_FOUND, format!("unknown camera `{name}`")).into_response();
+    }
+    if let Some(max_age) = query.max_age {
+        if let Some((taken, jpeg)) = app.snapshots.read().await.get(&name) {
+            if now().saturating_sub(*taken) <= max_age {
+                return ([(header::CONTENT_TYPE, "image/jpeg")], jpeg.clone()).into_response();
+            }
+        }
+    }
+    match take_snapshot(&app, &name).await {
+        Ok(jpeg) => ([(header::CONTENT_TYPE, "image/jpeg")], jpeg).into_response(),
+        Err(e) => (StatusCode::SERVICE_UNAVAILABLE, format!("{e:#}")).into_response(),
+    }
+}
+
+async fn take_snapshot(app: &App, name: &str) -> AnyResult<Vec<u8>> {
+    let camera = app.reactor.get(name).await?;
+    let jpeg = read(&camera, true, |c| {
+        Box::pin(async move { AnyResult::Ok(c.get_snapshot().await?) })
+    })
+    .await?;
+    app.snapshots
+        .write()
+        .await
+        .insert(name.to_string(), (now(), jpeg.clone()));
+    Ok(jpeg)
+}
+
+async fn ws_handler(
+    State(app): State<App>,
+    headers: HeaderMap,
+    Query(query): Query<AuthQuery>,
+    upgrade: WebSocketUpgrade,
+) -> Response {
+    if !authorized(&app, &headers, &query) {
+        return StatusCode::UNAUTHORIZED.into_response();
+    }
+    upgrade.on_upgrade(move |socket| client(app, socket))
+}
+
+async fn client(app: App, mut socket: WebSocket) {
+    let mut events = app.events.subscribe();
+    let hello = json!({
+        "type": "hello",
+        "version": env!("NEOLINK_VERSION"),
+        "cameras": cameras(&app).await,
+    });
+    if socket.send(Message::Text(hello.to_string())).await.is_err() {
+        return;
+    }
+    // Commands run concurrently (a sleeping camera may take a while); replies come back here
+    let (reply_tx, mut reply_rx) = mpsc::channel::<String>(32);
+    loop {
+        tokio::select! {
+            msg = socket.recv() => match msg {
+                Some(Ok(Message::Text(text))) => {
+                    let (app, tx) = (app.clone(), reply_tx.clone());
+                    tokio::spawn(async move {
+                        let reply = handle(&app, &text).await;
+                        let _ = tx.send(reply.to_string()).await;
+                    });
+                }
+                Some(Ok(Message::Close(_))) | Some(Err(_)) | None => break,
+                Some(Ok(_)) => {}
+            },
+            Some(reply) = reply_rx.recv() => {
+                if socket.send(Message::Text(reply)).await.is_err() {
+                    break;
+                }
+            },
+            event = events.recv() => match event {
+                Ok(event) => {
+                    if socket.send(Message::Text(event)).await.is_err() {
+                        break;
+                    }
+                }
+                Err(broadcast::error::RecvError::Lagged(_)) => {}
+                Err(broadcast::error::RecvError::Closed) => break,
+            },
+        }
+    }
+}
+
+#[derive(Deserialize)]
+struct Request {
+    id: Option<Value>,
+    command: String,
+    camera: Option<String>,
+    #[serde(default)]
+    args: Value,
+}
+
+async fn handle(app: &App, text: &str) -> Value {
+    let request: Request = match serde_json::from_str(text) {
+        Ok(r) => r,
+        Err(e) => {
+            return json!({"type": "result", "id": null, "success": false,
+                          "error": format!("invalid request: {e}")})
+        }
+    };
+    let id = request.id.clone().unwrap_or(Value::Null);
+    match command(app, &request).await {
+        Ok(result) => json!({"type": "result", "id": id, "success": true, "result": result}),
+        Err(e) => json!({"type": "result", "id": id, "success": false, "error": format!("{e:#}")}),
+    }
+}
+
+fn arg_bool(args: &Value, key: &str) -> AnyResult<bool> {
+    args.get(key)
+        .and_then(Value::as_bool)
+        .ok_or_else(|| anyhow!("missing boolean argument `{key}`"))
+}
+
+async fn command(app: &App, request: &Request) -> AnyResult<Value> {
+    if request.command == "list" {
+        return Ok(json!({"cameras": cameras(app).await}));
+    }
+    let name = request
+        .camera
+        .as_deref()
+        .ok_or_else(|| anyhow!("missing `camera`"))?;
+    if !app.states.read().await.contains_key(name) {
+        return Err(anyhow!("unknown camera `{name}`"));
+    }
+    let camera = app.reactor.get(name).await?;
+    let args = &request.args;
+    match request.command.as_str() {
+        "led" => {
+            let on = arg_bool(args, "on")?;
+            read(&camera, true, move |c| {
+                Box::pin(async move { AnyResult::Ok(c.led_light_set(on).await?) })
+            })
+            .await?;
+            update(app, name, |s| s.led = Some(on)).await;
+        }
+        "ir" => {
+            let label: &'static str = match args.get("state").and_then(Value::as_str) {
+                Some("on") => "on",
+                Some("off") => "off",
+                Some("auto") => "auto",
+                other => return Err(anyhow!("invalid IR state {other:?} (on|off|auto)")),
+            };
+            read(&camera, true, move |c| {
+                Box::pin(async move {
+                    let state = match label {
+                        "on" => LightState::On,
+                        "off" => LightState::Off,
+                        _ => LightState::Auto,
+                    };
+                    AnyResult::Ok(c.irled_light_set(state).await?)
+                })
+            })
+            .await?;
+            update(app, name, |s| s.ir = Some(label.to_string())).await;
+        }
+        "pir" => {
+            let on = arg_bool(args, "on")?;
+            read(&camera, true, move |c| {
+                Box::pin(async move { AnyResult::Ok(c.pir_set(on).await?) })
+            })
+            .await?;
+            update(app, name, |s| s.pir = Some(on)).await;
+        }
+        "reboot" => {
+            read(&camera, true, |c| {
+                Box::pin(async move { AnyResult::Ok(c.reboot().await?) })
+            })
+            .await?;
+        }
+        "siren" => {
+            read(&camera, true, |c| {
+                Box::pin(async move { AnyResult::Ok(c.siren().await?) })
+            })
+            .await?;
+        }
+        "battery" => {
+            let b = read(&camera, true, |c| {
+                Box::pin(async move { AnyResult::Ok(c.battery_info().await?) })
+            })
+            .await?;
+            update(app, name, |s| s.battery = Some(battery_state(&b))).await;
+        }
+        "refresh" => refresh(app, name, &camera, true).await,
+        "snapshot" => {
+            let jpeg = take_snapshot(app, name).await?;
+            return Ok(json!({"jpeg": BASE64.encode(jpeg)}));
+        }
+        "wakeup" => {
+            let minutes = args
+                .get("minutes")
+                .and_then(Value::as_u64)
+                .ok_or_else(|| anyhow!("missing integer argument `minutes`"))?;
+            let permit = camera.permit().await?;
+            tokio::spawn(async move {
+                // Start the countdown once the camera is actually connected
+                let _ = camera
+                    .run_task(|_| Box::pin(async move { AnyResult::Ok(()) }))
+                    .await;
+                sleep(Duration::from_secs(minutes * 60)).await;
+                drop(permit);
+            });
+        }
+        other => return Err(anyhow!("unknown command `{other}`")),
+    }
+    let state = app.states.read().await.get(name).cloned();
+    Ok(json!(state))
+}
