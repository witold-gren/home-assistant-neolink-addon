+/// Settings of the WebSocket control API
+#[derive(Debug, Deserialize, Serialize, Clone, PartialEq, Eq)]
+pub(crate) struct WebsocketConfig {
+    /// Address the HTTP/WebSocket server binds to
+    #[serde(default = "default_ws_bind")]
