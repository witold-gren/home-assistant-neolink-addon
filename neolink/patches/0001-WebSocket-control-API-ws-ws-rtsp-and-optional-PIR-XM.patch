+    /// Port of the HTTP/WebSocket server
+    #[serde(default = "default_ws_port")]
+    pub(crate) port: u16,
+    /// Optional bearer token required from clients (header or `?token=`)
+    #[serde(default, skip_serializing)]
+    pub(crate) token: Option<String>,
+    /// How often (ms) the battery is read while the camera is connected anyway; 0 disables
+    #[serde(default = "default_ws_battery_update")]
+    pub(crate) battery_update: u64,
+    /// Listen for motion events (keeps a passive listener on the camera connection)
+    #[serde(default)]
+    pub(crate) enable_motion: bool,
+}
+
+impl Default for WebsocketConfig {
+    fn default() -> Self {
+        Self {
+            bind: default_ws_bind(),
+            port: default_ws_port(),
+            token: None,
+            battery_update: default_ws_battery_update(),
+            enable_motion: false,
+        }
+    }
+}
+
+fn default_ws_bind() -> String {
+    "0.0.0.0".to_string()
+}
+
+fn default_ws_port() -> u16 {
+    3002
+}
+
+fn default_ws_battery_update() -> u64 {
+    1_800_000
+}
