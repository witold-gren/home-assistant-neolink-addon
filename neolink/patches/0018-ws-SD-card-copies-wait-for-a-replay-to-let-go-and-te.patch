From 9b654ac773c04d28d6b8679f6ea2f586fab80009 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Witold=20Gre=C5=84?= <witold.gren@gmail.com>
Date: Thu, 12 Nov 2026 11:27:50 +0100
Subject: [PATCH] ws: SD card copies wait for a replay to let go, and tell why
 they failed

A cover replay was dropped after its first picture while its task still stopped and drained the camera's stream, so the card lock went free with the replay's subscription (message 5, number 0) still held, and the next copy failed with "Simultaneous subscription, Some(0)". The cover now waits for the replay to end (SdDownload::finish), and a download asks again for a subscription still held (40 x 250 ms).

The newest recording copied after motion goes first in the queue, before older files asked for by hand. sd_recordings tells why the last copy of a file failed (copy_error), cleared when one succeeds.
---
 crates/core/src/bc_protocol/sdcard.rs | 45 ++++++++++++++++++++++++---
 src/ws/sd.rs                          | 29 +++++++++++++++--
 2 files changed, 66 insertions(+), 8 deletions(-)

diff --git a/crates/core/src/bc_protocol/sdcard.rs b/crates/core/src/bc_protocol/sdcard.rs
index 4790136..2bd7f23 100644
--- a/crates/core/src/bc_protocol/sdcard.rs
+++ b/crates/core/src/bc_protocol/sdcard.rs
@@ -36,6 +36,9 @@ const HOST_CHANNEL: u8 = 250;
 const REPLAY_IDLE: Duration = Duration::from_secs(15);
 /// The longest wait for the first data of a download
 const FIRST_DATA: Duration = Duration::from_secs(30);
+/// How often, and how long apart, a download asks again for a subscription still held
+const SUBSCRIBE_TRIES: u32 = 40;
+const SUBSCRIBE_WAIT: Duration = Duration::from_millis(250);
 /// A cover picture is complete after this long without more of it
 const COVER_IDLE: Duration = Duration::from_secs(3);
 
@@ -83,6 +86,17 @@ impl SdDownload {
     }
 }
 
+impl SdDownload {
+    /// Stop the download and wait until the camera's stream is let go (its subscription free for
+    /// the next one)
+    pub async fn finish(mut self) {
+        self.abort_handle.cancel();
+        if let Some(handle) = self.handle.take() {
+            let _ = handle.await;
+        }
+    }
+}
+
 impl Drop for SdDownload {
     fn drop(&mut self) {
         self.abort_handle.cancel();
@@ -306,13 +320,23 @@ impl BcCamera {
                 };
                 log::debug!("No cover, replaying the start of {sub_id}");
                 let mut replay = self.sd_replay(&sub_id, &recording.name, StreamKind::Sub);
+                let mut picture = Err(Error::Other("The replay held no picture"));
                 while let Some(packet) = replay.next().await {
-                    if let BcMedia::Iframe(frame) = packet? {
-                        // Dropping the replay stops it
-                        return Ok(frame);
+                    match packet {
+                        Ok(BcMedia::Iframe(frame)) => {
+                            picture = Ok(frame);
+                            break;
+                        }
+                        Ok(_) => {}
+                        Err(e) => {
+                            picture = Err(e);
+                            break;
+                        }
                     }
                 }
-                Err(Error::Other("The replay held no picture"))
+                // The replay is stopped and its stream let go before the card is free again
+                replay.finish().await;
+                picture
             }
         }
     }
@@ -651,7 +675,18 @@ impl BcCamera {
         let abort = abort_handle.clone();
         let (tx, rx) = channel(100);
         let handle = task::spawn(async move {
-            let mut sub = connection.subscribe(msg_id, msg_num).await?;
+            // A replay always uses message number 0: one the camera has not let go of yet (an
+            // earlier replay still stopping) frees itself in a moment
+            let mut tries = 0;
+            let mut sub = loop {
+                match connection.subscribe(msg_id, msg_num).await {
+                    Err(Error::SimultaneousSubscription { .. }) if tries < SUBSCRIBE_TRIES => {
+                        tries += 1;
+                        tokio::time::sleep(SUBSCRIBE_WAIT).await;
+                    }
+                    other => break other?,
+                }
+            };
             sub.send(request).await?;
             // The answer is the first message with a code: data of an earlier replay the camera
             // still sends (code 0) is left out
