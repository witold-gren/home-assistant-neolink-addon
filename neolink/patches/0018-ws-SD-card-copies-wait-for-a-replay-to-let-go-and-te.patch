+                queue.insert(1, video);
+            } else {
+                queue.push_back(video);
+            }
             added += 1;
         }
     }
@@ -485,6 +501,13 @@ fn start_worker(app: App, name: String, camera: NeoInstance, dir: PathBuf) {
         while let Some(video) = next_in_queue(&app, &name) {
             let result = sdcard::copy(&name, &camera, &dir, &video, app.sd_stream).await;
             done_with(&app, &name, &video);
+            if let Ok(mut errors) = app.sd.copy_errors.lock() {
+                let errors = errors.entry(name.clone()).or_default();
+                match &result {
