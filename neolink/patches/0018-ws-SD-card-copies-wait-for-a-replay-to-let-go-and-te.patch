+                "copy_error": errors.get(&file),
             })
         })
         .collect();
@@ -427,14 +436,16 @@ pub(super) async fn sync(
         }
     };
     let todo = sdcard::missing(&dir, &chosen);
-    let queued = enqueue(app, name, todo);
+    // The newest recording after motion goes first, before older files asked for by hand
+    let first = args.get("latest").and_then(Value::as_bool).unwrap_or(false);
+    let queued = enqueue(app, name, todo, first);
     log::info!("{name}: {queued} SD card recordings to copy");
