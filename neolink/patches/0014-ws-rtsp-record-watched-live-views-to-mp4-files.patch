index 0000000..d27b175
--- /dev/null
+++ b/src/record.rs
@@ -0,0 +1,213 @@
+//! Live-view recording: settings and switches
+//!
+//! While an RTSP client watches a camera whose recording is switched on, the frames it gets are
+//! also written, as they come, to `<dir>/<camera>/<YYYY-MM-DD>/HHMMSS-HHMMSS.mp4` (local time;
+//! see `rtsp::recorder`). The switch of each camera is a file in `switches`, so it survives a
+//! restart; `recording` tells who records right now, for the WebSocket state.
+use anyhow::{Context, Result};
+use std::{
+    collections::HashSet,
+    path::{Path, PathBuf},
+    sync::{Mutex, OnceLock},
+};
+use tokio::sync::broadcast;
+
+#[derive(Debug)]
+struct Settings {
+    dir: PathBuf,
+    switches: PathBuf,
+    changes: broadcast::Sender<String>,
+}
+
+static SETTINGS: OnceLock<Settings> = OnceLock::new();
+static RECORDING: Mutex<Option<HashSet<String>>> = Mutex::new(None);
+
+/// Turn recording on for this process: files go to `dir`, the switches are kept in `switches`.
+pub(crate) fn init(dir: &str, switches: &str) {
+    let (changes, _) = broadcast::channel(16);
+    let _ = SETTINGS.set(Settings {
+        dir: PathBuf::from(dir),
+        switches: PathBuf::from(switches),
+        changes,
+    });
+}
+
+/// Where the recordings of `camera` go, when recording is set up at all
+pub(crate) fn camera_dir(camera: &str) -> Option<PathBuf> {
+    SETTINGS.get().map(|s| s.dir.join(file_name(camera)))
+}
+
+fn switch_path(settings: &Settings, camera: &str) -> PathBuf {
+    settings.switches.join(file_name(camera))
+}
+
+/// A camera name as one path segment: no separators, no `..`
+fn file_name(camera: &str) -> String {
+    let name: String = camera
+        .chars()
+        .map(|c| {
+            if matches!(c, '/' | '\\' | '\0') {
+                '_'
+            } else {
+                c
+            }
+        })
+        .collect();
+    if name.trim_matches('.').is_empty() {
+        "_".to_string()
+    } else {
+        name
+    }
+}
+
+/// Whether live views of `camera` are recorded
+pub(crate) fn enabled(camera: &str) -> bool {
+    SETTINGS
+        .get()
+        .is_some_and(|s| switch_path(s, camera).exists())
+}
+
+/// Switch the recording of `camera` on or off
+pub(crate) fn set_enabled(camera: &str, on: bool) -> Result<()> {
+    let settings = SETTINGS
+        .get()
+        .context("live-view recording is not set up (record_dir)")?;
+    let path = switch_path(settings, camera);
+    if on {
+        std::fs::create_dir_all(&settings.switches)
+            .with_context(|| format!("Cannot create {}", settings.switches.display()))?;
+        std::fs::write(&path, b"on").with_context(|| format!("Cannot write {}", path.display()))?;
+    } else if path.exists() {
+        std::fs::remove_file(&path).with_context(|| format!("Cannot remove {}", path.display()))?;
+    }
+    let _ = settings.changes.send(camera.to_string());
+    Ok(())
+}
+
+/// Whether a live view of `camera` is being recorded right now
+pub(crate) fn recording(camera: &str) -> bool {
+    RECORDING
+        .lock()
+        .map(|r| r.as_ref().is_some_and(|set| set.contains(camera)))
+        .unwrap_or(false)
+}
+
+/// Claim the recording of `camera`: false when another live view of it records already
+pub(crate) fn claim(camera: &str) -> bool {
+    let claimed = RECORDING
+        .lock()
+        .map(|mut r| {
+            r.get_or_insert_with(HashSet::new)
+                .insert(camera.to_string())
+        })
+        .unwrap_or(false);
+    if claimed {
+        notify(camera);
+    }
+    claimed
+}
+
+/// Let the recording of `camera` go
+pub(crate) fn release(camera: &str) {
+    if let Ok(mut r) = RECORDING.lock() {
+        if let Some(set) = r.as_mut() {
+            set.remove(camera);
+        }
+    }
+    notify(camera);
+}
+
+fn notify(camera: &str) {
+    if let Some(settings) = SETTINGS.get() {
+        let _ = settings.changes.send(camera.to_string());
+    }
+}
+
+/// Names of cameras whose switch or recording changed
+pub(crate) fn subscribe() -> Option<broadcast::Receiver<String>> {
+    SETTINGS.get().map(|s| s.changes.subscribe())
+}
+
+/// The final name of a recording that ran from `start` to `end`: `HHMMSS-HHMMSS.mp4`
+pub(crate) fn final_name(start: &chrono::NaiveTime, end: &chrono::NaiveTime) -> String {
+    format!("{}-{}.mp4", start.format("%H%M%S"), end.format("%H%M%S"))
+}
+
+/// A recording still being written, or one cut short by a crash: `HHMMSS-recording.mp4`
+pub(crate) fn partial_name(start: &chrono::NaiveTime) -> String {
+    format!("{}-recording.mp4", start.format("%H%M%S"))
+}
+
+/// Give recordings cut short by a restart their final name, from the time of their last write
+pub(crate) fn finish_partial(dir: &Path) {
+    let Ok(days) = std::fs::read_dir(dir) else {
+        return;
+    };
+    for day in days.flatten() {
+        let Ok(files) = std::fs::read_dir(day.path()) else {
+            continue;
+        };
+        for file in files.flatten() {
+            let path = file.path();
+            let name = file.file_name().to_string_lossy().to_string();
+            let Some(start) = name.strip_suffix("-recording.mp4") else {
+                continue;
+            };
+            let Some(end) = file
+                .metadata()
+                .and_then(|m| m.modified())
+                .ok()
+                .map(|t| chrono::DateTime::<chrono::Local>::from(t).time())
+            else {
+                continue;
+            };
+            let target = path.with_file_name(format!("{start}-{}.mp4", end.format("%H%M%S")));
+            match std::fs::rename(&path, &target) {
+                Ok(()) => log::info!("Recording cut short, kept as {}", target.display()),
+                Err(e) => log::warn!("Cannot rename {}: {e}", path.display()),
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use chrono::NaiveTime;
+
+    #[test]
+    fn names_follow_the_eufy_bridge() {
+        let start = NaiveTime::from_hms_opt(13, 20, 5).unwrap();
+        let end = NaiveTime::from_hms_opt(13, 20, 41).unwrap();
+        assert_eq!(final_name(&start, &end), "132005-132041.mp4");
+        assert_eq!(partial_name(&start), "132005-recording.mp4");
+    }
+
+    #[test]
+    fn a_camera_name_stays_one_path_segment() {
+        assert_eq!(file_name("G330"), "G330");
+        assert_eq!(file_name("../etc"), ".._etc");
+        assert_eq!(file_name(".."), "_");
+    }
+
+    #[test]
+    fn partial_recordings_get_their_end_time() {
+        let dir = std::env::temp_dir().join(format!("neolink-record-{}", std::process::id()));
+        let day = dir.join("2026-11-10");
+        std::fs::create_dir_all(&day).unwrap();
+        std::fs::write(day.join("132005-recording.mp4"), b"x").unwrap();
+        std::fs::write(day.join("120000-120030.mp4"), b"x").unwrap();
+        finish_partial(&dir);
+        let mut names: Vec<String> = std::fs::read_dir(&day)
+            .unwrap()
+            .flatten()
+            .map(|f| f.file_name().to_string_lossy().to_string())
+            .collect();
+        names.sort();
+        std::fs::remove_dir_all(&dir).unwrap();
+        assert_eq!(names.len(), 2);
+        assert_eq!(names[0], "120000-120030.mp4");
+        assert!(names[1].starts_with("132005-") && names[1].ends_with(".mp4"));
+        assert!(!names[1].contains("recording"));
+    }
+}
