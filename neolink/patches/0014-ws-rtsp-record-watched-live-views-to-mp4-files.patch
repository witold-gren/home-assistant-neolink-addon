 /// Starts and stops per-camera watchers as cameras come and go in the config
+/// Follow the recording switches and the recordings into the cameras' state
+async fn watch_recording(app: App) -> AnyResult<()> {
+    let Some(mut changes) = crate::record::subscribe() else {
+        return Ok(());
+    };
+    loop {
+        match changes.recv().await {
+            Ok(name) => {
+                let (on, now) = (
+                    crate::record::enabled(&name),
+                    crate::record::recording(&name),
+                );
+                update(&app, &name, |s| {
+                    s.record_live = Some(on);
+                    s.recording_live = now;
+                })
+                .await;
+            }
+            Err(broadcast::error::RecvError::Lagged(_)) => continue,
+            Err(broadcast::error::RecvError::Closed) => return Ok(()),
+        }
+    }
+}
