diff --git a/src/rtsp/recorder.rs b/src/rtsp/recorder.rs
new file mode 100644
index 0000000..7e3d566
--- /dev/null
+++ b/src/rtsp/recorder.rs
@@ -0,0 +1,348 @@
+//! Writes a watched live view to an mp4 file (see `crate::record`)
+//!
+//! The frames are the camera's own: H.264/H.265 and AAC are muxed as they come, stamped by the
+//! clock on arrival, nothing is transcoded. The mp4 is fragmented every second, so a file cut short by a crash still plays;
+//! the file is named `HHMMSS-recording.mp4` while it is written and `HHMMSS-HHMMSS.mp4` once done.
+use anyhow::{anyhow, Context, Result};
+use chrono::Local;
+use gstreamer::{prelude::*, Caps, ClockTime, Element, ElementFactory, MessageView, Pipeline};
+use gstreamer_app::{AppSrc, AppStreamType};
+use neolink_core::bcmedia::model::VideoType;
+use std::{path::PathBuf, time::Duration};
+
+use crate::record;
+
+/// How long the muxer waits for frames of a track that is late or silent
+const MUX_LATENCY: Duration = Duration::from_millis(500);
+
+/// How long a finished recording may take to write its last fragment
+const FINISH_TIMEOUT: Duration = Duration::from_secs(5);
+
+pub(crate) struct Recorder {
+    camera: String,
+    pipeline: Pipeline,
+    video: AppSrc,
+    audio: Option<AppSrc>,
+    path: PathBuf,
+    start: chrono::DateTime<Local>,
+    finished: bool,
+}
+
+fn element(kind: &str) -> Result<Element> {
+    ElementFactory::make(kind)
+        .build()
+        .with_context(|| format!("GStreamer element {kind} is missing"))
+}
+
+fn appsrc(caps: Caps) -> Result<AppSrc> {
+    let src = element("appsrc")?
+        .dynamic_cast::<AppSrc>()
+        .map_err(|_| anyhow!("Cannot cast to appsrc"))?;
+    src.set_caps(Some(&caps));
+    // Live, stamped by the clock as the frames arrive: a camera's own frame times drift from its
+    // nominal rate, and its sound comes only now and then. A non-live mp4mux waited for the silent
+    // sound and wrote nothing after the first second.
+    src.set_is_live(true);
+    src.set_do_timestamp(true);
+    src.set_format(gstreamer::Format::Time);
+    src.set_stream_type(AppStreamType::Stream);
+    Ok(src)
+}
+
+impl Recorder {
+    /// Start recording `camera` when its recording is switched on and no other live view of it
+    /// records already. `aac`: the camera sends AAC sound (ADPCM is left out of the file).
+    pub(crate) fn start(camera: &str, video: VideoType, aac: bool) -> Option<Recorder> {
+        let dir = record::camera_dir(camera)?;
+        if !record::enabled(camera) || !record::claim(camera) {
+            return None;
+        }
+        match Self::open(camera, dir, video, aac) {
+            Ok(recorder) => {
+                log::info!(
+                    "{camera}: recording the live view to {}",
+                    recorder.path.display()
+                );
+                Some(recorder)
+            }
+            Err(e) => {
+                log::warn!("{camera}: cannot record the live view: {e:#}");
+                record::release(camera);
+                None
+            }
+        }
+    }
+
+    fn open(camera: &str, dir: PathBuf, video: VideoType, aac: bool) -> Result<Recorder> {
+        let start = Local::now();
+        let day = dir.join(start.format("%Y-%m-%d").to_string());
+        std::fs::create_dir_all(&day)
+            .with_context(|| format!("Cannot create {}", day.display()))?;
+        let path = day.join(record::partial_name(&start.time()));
+
+        let pipeline = Pipeline::new();
+        let (video_caps, parser) = match video {
+            VideoType::H264 => ("video/x-h264", "h264parse"),
+            VideoType::H265 => ("video/x-h265", "h265parse"),
+        };
+        let video_src = appsrc(
+            Caps::builder(video_caps)
+                .field("stream-format", "byte-stream")
+                .build(),
+        )?;
+        let video_parse = element(parser)?;
+        let video_queue = element("queue")?;
+        let mux = element("mp4mux")?;
+        mux.set_property("fragment-duration", 1000u32);
+        // How long the muxer waits for a late track before it writes the others
+        mux.set_property("latency", MUX_LATENCY.as_nanos() as u64);
+        let sink = element("filesink")?;
+        sink.set_property("location", path.to_string_lossy().to_string());
+
+        pipeline.add_many([
+            video_src.upcast_ref(),
+            &video_parse,
+            &video_queue,
+            &mux,
+            &sink,
+        ])?;
+        Element::link_many([
+            video_src.upcast_ref(),
+            &video_parse,
+            &video_queue,
+            &mux,
+            &sink,
+        ])?;
+
+        let audio = if aac {
+            let audio_src = appsrc(
+                Caps::builder("audio/mpeg")
+                    .field("mpegversion", 4i32)
+                    .field("stream-format", "adts")
+                    .build(),
+            )?;
+            let audio_parse = element("aacparse")?;
+            let audio_queue = element("queue")?;
+            pipeline.add_many([audio_src.upcast_ref(), &audio_parse, &audio_queue])?;
+            Element::link_many([audio_src.upcast_ref(), &audio_parse, &audio_queue, &mux])?;
+            Some(audio_src)
+        } else {
+            None
+        };
+
+        pipeline
+            .set_state(gstreamer::State::Playing)
+            .context("The recording pipeline does not start")?;
+        Ok(Recorder {
+            camera: camera.to_string(),
+            pipeline,
+            video: video_src,
+            audio,
+            path,
+            start,
+            finished: false,
+        })
+    }
+
+    /// A video frame (Annex B), as it arrives
+    pub(crate) fn video(&self, data: &[u8]) {
+        push(&self.video, data);
+    }
+
+    /// An ADTS AAC frame, as it arrives
+    pub(crate) fn audio(&self, data: &[u8]) {
+        if let Some(audio) = self.audio.as_ref() {
+            push(audio, data);
+        }
+    }
+
+    /// The file being written
+    #[allow(dead_code)]
+    pub(crate) fn path(&self) -> &PathBuf {
+        &self.path
+    }
+
+    /// End the file and give it its final name (dropping the recorder does the same)
+    #[cfg_attr(not(test), allow(dead_code))]
+    pub(crate) fn finish(mut self) -> Option<PathBuf> {
+        self.close()
+    }
+
+    fn close(&mut self) -> Option<PathBuf> {
+        if self.finished {
+            return None;
+        }
+        self.finished = true;
+        let _ = self.video.end_of_stream();
+        if let Some(audio) = self.audio.as_ref() {
+            let _ = audio.end_of_stream();
+        }
+        if let Some(bus) = self.pipeline.bus() {
+            let deadline = ClockTime::from_mseconds(FINISH_TIMEOUT.as_millis() as u64);
+            match bus.timed_pop_filtered(
+                deadline,
+                &[gstreamer::MessageType::Eos, gstreamer::MessageType::Error],
+            ) {
+                Some(message) => {
+                    if let MessageView::Error(e) = message.view() {
+                        log::warn!(
+                            "{}: the recording ended with an error: {}",
+                            self.camera,
+                            e.error()
+                        );
+                    }
+                }
+                None => log::warn!("{}: the recording did not end in time", self.camera),
+            }
+        }
+        let _ = self.pipeline.set_state(gstreamer::State::Null);
+        record::release(&self.camera);
+
+        let target = self
+            .path
+            .with_file_name(record::final_name(&self.start.time(), &Local::now().time()));
+        match std::fs::rename(&self.path, &target) {
+            Ok(()) => {
+                log::info!("{}: recording kept as {}", self.camera, target.display());
+                Some(target)
+            }
+            Err(e) => {
+                log::warn!(
+                    "{}: cannot rename {}: {e}",
+                    self.camera,
+                    self.path.display()
+                );
+                None
+            }
+        }
+    }
+}
+
+impl Drop for Recorder {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
+
+fn push(src: &AppSrc, data: &[u8]) {
+    // A full or stopped recording loses frames, never the live view
+    let _ = src.push_buffer(gstreamer::Buffer::from_slice(data.to_vec()));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Synthetic camera frames: H.264 Annex B and ADTS AAC made by GStreamer itself
+    fn encoded(launch: &str, count: usize) -> Vec<Vec<u8>> {
+        let pipeline = gstreamer::parse::launch(launch)
+            .unwrap()
+            .downcast::<Pipeline>()
+            .unwrap();
+        let sink = pipeline
+            .by_name("out")
+            .unwrap()
+            .downcast::<gstreamer_app::AppSink>()
+            .unwrap();
+        pipeline.set_state(gstreamer::State::Playing).unwrap();
+        let frames = (0..count)
+            .filter_map(|_| sink.try_pull_sample(ClockTime::from_seconds(10)))
+            .map(|s| s.buffer().unwrap().map_readable().unwrap().to_vec())
+            .collect();
+        pipeline.set_state(gstreamer::State::Null).unwrap();
+        frames
+    }
+
+    /// The kinds of tracks qtdemux finds in an mp4 (video/x-h264, audio/mpeg, ...) and how many
+    /// video frames it holds
+    fn tracks(path: &std::path::Path) -> (Vec<String>, usize) {
+        let pipeline = Pipeline::new();
+        let source = element("filesrc").unwrap();
+        source.set_property("location", path.to_string_lossy().to_string());
+        let demux = element("qtdemux").unwrap();
+        pipeline.add_many([&source, &demux]).unwrap();
+        source.link(&demux).unwrap();
+        let found = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
+        let seen = found.clone();
+        let frames = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let counted = frames.clone();
+        let bin = pipeline.clone();
+        demux.connect_pad_added(move |_, pad| {
+            let caps = pad.current_caps().unwrap();
+            let kind = caps.structure(0).unwrap().name().to_string();
+            if kind.starts_with("video/") {
+                let counted = counted.clone();
+                pad.add_probe(gstreamer::PadProbeType::BUFFER, move |_, _| {
+                    counted.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+                    gstreamer::PadProbeReturn::Ok
+                });
+            }
+            seen.lock().unwrap().push(kind);
+            let sink = element("fakesink").unwrap();
+            bin.add(&sink).unwrap();
+            sink.sync_state_with_parent().unwrap();
+            pad.link(&sink.static_pad("sink").unwrap()).unwrap();
+        });
+        pipeline.set_state(gstreamer::State::Playing).unwrap();
+        let bus = pipeline.bus().unwrap();
+        bus.timed_pop_filtered(
+            ClockTime::from_seconds(10),
+            &[gstreamer::MessageType::Eos, gstreamer::MessageType::Error],
+        );
+        pipeline.set_state(gstreamer::State::Null).unwrap();
+        let kinds = found.lock().unwrap().clone();
+        (kinds, frames.load(std::sync::atomic::Ordering::SeqCst))
+    }
+
+    #[test]
+    fn a_watched_live_view_becomes_a_named_mp4_with_sound() {
+        gstreamer::init().unwrap();
+        let dir = std::env::temp_dir().join(format!("neolink-recorder-{}", std::process::id()));
+        let switches = dir.join("switches");
+        record::init(&dir.to_string_lossy(), &switches.to_string_lossy());
+
+        // Switched off: nothing is recorded
+        assert!(Recorder::start("Garden", VideoType::H264, true).is_none());
+
+        record::set_enabled("Garden", true).unwrap();
+        let video = encoded(
+            "videotestsrc num-buffers=30 ! video/x-raw,width=320,height=240,framerate=15/1 \
+             ! x264enc key-int-max=15 ! video/x-h264,stream-format=byte-stream,alignment=au \
+             ! appsink name=out sync=false",
+            30,
+        );
+        let audio = encoded(
+            "audiotestsrc num-buffers=30 ! audio/x-raw,rate=16000,channels=1 ! avenc_aac \
+             ! aacparse ! audio/mpeg,stream-format=adts ! appsink name=out sync=false",
+            30,
+        );
+        let recorder = Recorder::start("Garden", VideoType::H264, true).expect("recording");
+        assert!(record::recording("Garden"));
+        // A second live view of the same camera does not record it twice
+        assert!(Recorder::start("Garden", VideoType::H264, true).is_none());
+        // As a camera sends them: in real time, and the sound stops after a few frames (Reolink
+        // cameras send sound only now and then) while the picture goes on.
+        for (i, frame) in video.iter().enumerate() {
+            recorder.video(frame);
+            if let Some(sound) = audio.get(i).filter(|_| i < 5) {
+                recorder.audio(sound);
+            }
+            std::thread::sleep(Duration::from_millis(66));
+        }
+        let path = recorder.finish().expect("a named file");
+        assert!(!record::recording("Garden"));
+
+        let name = path.file_name().unwrap().to_string_lossy().to_string();
+        assert!(
+            name.len() == "HHMMSS-HHMMSS.mp4".len() && name.ends_with(".mp4"),
+            "{}",
+            name
+        );
+        let (kinds, frames) = tracks(&path);
+        std::fs::remove_dir_all(&dir).unwrap();
+        assert!(kinds.contains(&"video/x-h264".to_string()), "{:?}", kinds);
+        assert!(kinds.contains(&"audio/mpeg".to_string()), "{:?}", kinds);
+        // The whole picture, not only the part with sound
+        assert!(frames >= 28, "{} of 30 video frames", frames);
+    }
+}
