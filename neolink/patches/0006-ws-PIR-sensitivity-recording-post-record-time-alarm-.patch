+use super::{BcCamera, Error, Result};
+use crate::bc::{model::*, xml::*};
+
+impl BcCamera {
+    fn channel_query(&self, msg_id: u32, msg_num: u16, payload: Option<BcPayloads>) -> Bc {
+        Bc {
+            meta: BcMeta {
+                msg_id,
+                channel_id: self.channel_id,
+                msg_num,
+                response_code: 0,
+                stream_type: 0,
+                class: 0x6414,
+            },
+            body: BcBody::ModernMsg(ModernMsg {
+                extension: Some(Extension {
+                    channel_id: Some(self.channel_id),
+                    ..Default::default()
+                }),
+                payload,
+            }),
+        }
+    }
+
+    /// Sends a bare channel query with the given message id and returns the camera's response
+    /// code. Meant for discovering what a camera supports: with the camera's `debug` option the
+    /// reply payload is printed as text.
+    pub async fn probe(&self, msg_id: u32) -> Result<u16> {
+        let msg_num = self.new_message_num();
+        let connection = self.get_connection();
+        let mut sub = connection.subscribe(msg_id, msg_num).await?;
+        sub.send(self.channel_query(msg_id, msg_num, None)).await?;
+        Ok(sub.recv().await?.meta.response_code)
+    }
+
+    /// Queries `msg_id` for the channel and returns the reply's XML
+    async fn get_xml(&self, msg_id: u32) -> Result<BcXml> {
+        let msg_num = self.new_message_num();
+        let connection = self.get_connection();
+        let mut sub = connection.subscribe(msg_id, msg_num).await?;
+        sub.send(self.channel_query(msg_id, msg_num, None)).await?;
+        let msg = sub.recv().await?;
+        if msg.meta.response_code != 200 {
+            return Err(Error::CameraServiceUnavailable {
+                id: msg.meta.msg_id,
+                code: msg.meta.response_code,
+            });
+        }
+        match msg.body {
+            BcBody::ModernMsg(ModernMsg {
+                payload: Some(BcPayloads::BcXml(xml)),
+                ..
+            }) => Ok(xml),
+            _ => Err(Error::UnintelligibleReply {
+                reply: std::sync::Arc::new(Box::new(msg)),
+                why: "Expected an xml payload",
+            }),
+        }
+    }
+
+    /// Sends `xml` to the channel with `msg_id` and checks the camera accepted it
+    async fn set_xml(&self, msg_id: u32, xml: BcXml) -> Result<()> {
+        let msg_num = self.new_message_num();
+        let connection = self.get_connection();
+        let mut sub = connection.subscribe(msg_id, msg_num).await?;
+        sub.send(self.channel_query(msg_id, msg_num, Some(BcPayloads::BcXml(xml))))
+            .await?;
+        let msg = sub.recv().await?;
+        if msg.meta.response_code != 200 {
+            return Err(Error::CameraServiceUnavailable {
+                id: msg.meta.msg_id,
+                code: msg.meta.response_code,
+            });
+        }
+        Ok(())
+    }
+
+    /// Recording timing: post-record time and its allowed values
+    pub async fn get_record_cfg(&self) -> Result<RecordCfg> {
+        self.get_xml(MSG_ID_GET_RECORD_CFG)
+            .await?
+            .record_cfg
+            .ok_or(Error::Other("Expected RecordCfg xml"))
+    }
+
+    /// Writes recording timing back (send what [Self::get_record_cfg] returned, changed)
+    pub async fn set_record_cfg(&self, record_cfg: RecordCfg) -> Result<()> {
+        let xml = BcXml {
+            record_cfg: Some(record_cfg),
+            ..Default::default()
+        };
+        self.set_xml(MSG_ID_SET_RECORD_CFG, xml).await
+    }
+
+    /// Recording (to the SD card) on/off
+    pub async fn get_record(&self) -> Result<ScheduleTask> {
+        self.get_xml(MSG_ID_GET_RECORD)
+            .await?
+            .record
+            .ok_or(Error::Other("Expected Record xml"))
+    }
+
+    /// Writes recording on/off back (send what [Self::get_record] returned, changed)
+    pub async fn set_record(&self, record: ScheduleTask) -> Result<()> {
+        let xml = BcXml {
+            record: Some(record),
+            ..Default::default()
+        };
+        self.set_xml(MSG_ID_SET_RECORD, xml).await
+    }
+
+    /// Alarm sound (siren) on detection on/off
+    pub async fn get_audio_task(&self) -> Result<ScheduleTask> {
+        self.get_xml(MSG_ID_GET_AUDIO_TASK)
+            .await?
+            .audio_task
+            .ok_or(Error::Other("Expected AudioTask xml"))
+    }
+
+    /// Writes the alarm sound setting back (send what [Self::get_audio_task] returned, changed)
+    pub async fn set_audio_task(&self, audio_task: ScheduleTask) -> Result<()> {
+        let xml = BcXml {
+            audio_task: Some(audio_task),
+            ..Default::default()
+        };
+        self.set_xml(MSG_ID_SET_AUDIO_TASK, xml).await
+    }
+}
