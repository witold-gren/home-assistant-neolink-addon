+/// What a refresh asks the card for, and whether that is a full search. Within
+/// `FULL_SEARCH_EVERY` of the last full search only the time since the last search (less
+/// `SEARCH_OVERLAP`) is asked; the kept list stands for the rest. `whole`: the asked range is the
+/// whole card.
+fn search_range(
+    list: &CardList,
+    asked: (SdTime, SdTime),
+    whole: bool,
+    now: u64,
+) -> ((SdTime, SdTime), bool) {
+    let since = match (list.updated, list.full) {
+        (Some(updated), Some(full)) if now.saturating_sub(full) < FULL_SEARCH_EVERY => {
+            local_time(updated.saturating_sub(SEARCH_OVERLAP))
+        }
+        _ => None,
+    };
+    match since {
+        Some(since) if since > asked.0 => ((since, asked.1), false),
+        _ => (asked, whole),
+    }
+}
+
+fn local_time(unix: u64) -> Option<SdTime> {
+    use chrono::TimeZone;
+    chrono::Local
+        .timestamp_opt(unix as i64, 0)
+        .single()
+        .map(|t| sdcard::sd_time(&t.naive_local()))
+}
+
+/// The kept recordings from before `from` and those just found, in order, each once
+fn merge(kept: &[SdRecording], found: Vec<SdRecording>, from: &SdTime) -> Vec<SdRecording> {
+    let new: HashSet<String> = found.iter().map(file_of).collect();
+    let mut all: Vec<SdRecording> = kept
+        .iter()
+        .filter(|v| v.start < *from && !new.contains(&file_of(v)))
+        .cloned()
+        .chain(found)
+        .collect();
+    all.sort_by(|a, b| (a.start, &a.name).cmp(&(b.start, &b.name)));
+    all
+}
+
 /// Fetch the covers the list lacks, newest first, in the background
 fn thumbnails(app: App, name: String, camera: NeoInstance) {
     let Some(thumbs) = thumbs_dir(&app, &name) else {
@@ -611,4 +678,65 @@ mod tests {
         };
         assert_eq!(iso(&t), "2026-10-15T12:05:09");
     }
+
+    fn at(day: u8, hour: u8) -> SdTime {
+        SdTime {
+            year: 2026,
+            month: 11,
+            day,
+            hour,
+            minute: 0,
+            second: 0,
+        }
+    }
+
+    fn video(day: u8, hour: u8) -> SdRecording {
+        SdRecording {
+            start: at(day, hour),
+            end: SdTime {
+                minute: 1,
+                ..at(day, hour)
+            },
+            kinds: "pir".into(),
+            name: format!("{day}-{hour}"),
+            id: None,
+            size: None,
+            sub_id: None,
+        }
+    }
+
+    #[test]
+    fn a_refresh_soon_after_a_full_search_asks_only_for_what_is_new() {
+        let now = 2_000_000_000;
+        let asked = (at(1, 0), at(12, 13));
+        // Never searched in full: the whole card
+        assert_eq!(search_range(&CardList::default(), asked, true, now), (asked, true));
+        let list = CardList {
+            updated: Some(now - 600),
+            full: Some(now - 3600),
+            ..Default::default()
+        };
+        let (range, full) = search_range(&list, asked, true, now);
+        assert!(!full);
+        assert_eq!(range.0, local_time(now - 600 - SEARCH_OVERLAP).unwrap());
+        assert_eq!(range.1, asked.1);
+        // A day after the full search: the whole card again (recordings the card overwrote go)
+        let old = CardList {
+            full: Some(now - FULL_SEARCH_EVERY),
+            ..list.clone()
+        };
+        assert_eq!(search_range(&old, asked, true, now), (asked, true));
+        // Asked for less than what is new: as asked, not a full search
+        let narrow = (local_time(now - 60).unwrap(), asked.1);
+        assert_eq!(search_range(&list, narrow, false, now), (narrow, false));
+    }
+
+    #[test]
+    fn the_new_part_of_the_card_joins_the_kept_list() {
+        let kept = vec![video(10, 8), video(12, 9), video(12, 11)];
+        // The search since 12th 10:00 found the 11:00 one again and a new one
+        let merged = merge(&kept, vec![video(12, 11), video(12, 12)], &at(12, 10));
+        let names: Vec<&str> = merged.iter().map(|v| v.name.as_str()).collect();
+        assert_eq!(names, ["10-8", "12-9", "12-11", "12-12"]);
+    }
 }
