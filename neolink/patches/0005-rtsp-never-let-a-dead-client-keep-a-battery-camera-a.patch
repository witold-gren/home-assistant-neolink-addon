+/// How long an appsrc may refuse buffers as flushing before the stream is dropped. A client
+/// that left without a TEARDOWN leaves its pipeline flushing forever, and a stream that keeps
+/// running for nobody holds the camera awake (and drains a battery camera).
+const FLUSHING_LIMIT: Duration = Duration::from_secs(15);
+
+/// Per-client sending state
+#[derive(Default)]
+struct SendState {
+    flushing_since: Option<Instant>,
+}
+
 fn send_to_sources(
     data: BcMedia,
-    pools: &mut HashMap<usize, gstreamer::BufferPool>,
+    pools: &mut SendState,
     vid_src: &Option<AppSrc>,
     aud_src: &Option<AppSrc>,
     vid_ts: &mut u32,
@@ -356,7 +367,7 @@ fn send_to_appsrc(
     appsrc: &AppSrc,
     data: Vec<u8>,
     mut ts: Duration,
-    pools: &mut HashMap<usize, gstreamer::BufferPool>,
+    state: &mut SendState,
 ) -> AnyResult<()> {
     check_live(appsrc)?; // Stop if appsrc is dropped
 
@@ -373,47 +384,29 @@ fn send_to_appsrc(
                 ts = Duration::from_micros(time.useconds());
             } else {
                 // Not playing
-                return Ok(());
+                return not_playing(appsrc, state);
             }
         } else {
             // Clock not up yet
-            return Ok(());
+            return not_playing(appsrc, state);
         }
     }
+    // A fresh buffer per frame. The former fixed-size pool (32 buffers) blocked forever in
+    // acquire_buffer once a stalled pipeline stopped releasing them, which froze this thread
+    // and with it the camera stream (upstream neolink #340).
     let buf = {
-        let msg_size = data.len();
-
-        // Get or create a pool of this len
-        let pool = pools.entry(msg_size).or_insert_with_key(|size| {
-            let pool = gstreamer::BufferPool::new();
-            let mut pool_config = pool.config();
-            // Set a max buffers to ensure we don't grow in memory endlessly
-            pool_config.set_params(None, (*size) as u32, 8, 32);
-            pool.set_config(pool_config).unwrap();
-            pool.set_active(true).unwrap();
-            pool
-        });
-
-        // Get a buffer from the pool and then copy in the data
-        let gst_buf = {
-            let mut new_buf = pool.acquire_buffer(None).unwrap();
-            let gst_buf_mut = new_buf.get_mut().unwrap();
-            let time = ClockTime::from_useconds(ts.as_micros() as u64);
-            gst_buf_mut.set_dts(time);
-            gst_buf_mut.set_pts(time);
-            let mut gst_buf_data = gst_buf_mut.map_writable().unwrap();
-            gst_buf_data.copy_from_slice(data.as_slice());
-            drop(gst_buf_data);
-            new_buf
-        };
-
-        // Return the new buffer with the data
-        gst_buf
+        let mut buf = gstreamer::Buffer::from_mut_slice(data);
+        let buf_mut = buf.get_mut().expect("A new buffer is writable");
+        let time = ClockTime::from_useconds(ts.as_micros() as u64);
+        buf_mut.set_dts(time);
+        buf_mut.set_pts(time);
+        buf
     };
 
     // Push buffer into the appsrc
     match appsrc.push_buffer(buf) {
         Ok(_) => {
+            state.flushing_since = None;
             // log::info!(
             //     "Send {}{} on {}",
             //     data.data.len(),
@@ -423,12 +416,12 @@ fn send_to_appsrc(
             Ok(())
         }
         Err(FlowError::Flushing) => {
-            // Buffer is full just skip
+            // Not playing (yet): skip the frame, but not forever
             log::info!(
                 "Buffer full on {} pausing stream until client consumes frames",
                 appsrc.name()
             );
-            Ok(())
+            not_playing(appsrc, state)
         }
         Err(e) => Err(anyhow!("Error in streaming: {e:?}")),
     }?;
@@ -444,6 +437,19 @@ fn send_to_appsrc(
     }
     Ok(())
 }
+/// Skips a frame while the appsrc cannot take it, until FLUSHING_LIMIT
+fn not_playing(appsrc: &AppSrc, state: &mut SendState) -> AnyResult<()> {
+    let since = *state.flushing_since.get_or_insert_with(Instant::now);
+    if since.elapsed() > FLUSHING_LIMIT {
+        Err(anyhow!(
+            "App source {} not playing for {FLUSHING_LIMIT:?}, client is gone",
+            appsrc.name()
+        ))
+    } else {
+        Ok(())
+    }
+}
+
 fn check_live(app: &AppSrc) -> Result<()> {
     app.bus().ok_or(anyhow!("App source is closed"))?;
     app.pads()
